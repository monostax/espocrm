            [{"name": "celular"}],
            [{"name": "telefoneResidencial"}, {"name": "telefoneResidencial1"}]
        ]
    },
    {
        "name": "dadosPessoaisPanel",
        "label": "Dados Pessoais",
        "panelIconClass": "fas fa-id-card",
