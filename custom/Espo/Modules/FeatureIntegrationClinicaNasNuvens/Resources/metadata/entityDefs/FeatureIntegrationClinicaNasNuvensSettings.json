{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 255,
            "required": true
        },
        "isActive": {
            "type": "bool",
            "default": true
        },
        "migrationStatus": {
            "type": "enum",
            "options": ["idle", "inProgress", "completed", "failed"],
            "default": "idle",
            "required": true
        },
        "exportStatus": {
            "type": "enum",
            "options": ["idle", "requesting", "downloading", "completed", "failed"],
            "default": "idle",
            "readOnly": true
        },
        "importStatus": {
            "type": "enum",
            "options": ["idle", "inProgress", "completed", "failed"],
            "default": "idle",
            "readOnly": true
        },
        "autoImportDateRange": {
            "type": "enum",
            "options": ["none", "rolling30d", "rolling90d", "rolling365d"],
            "default": "none"
        },
        "tenant": {
            "type": "link",
            "required": true
        },
        "apiCredential": {
            "type": "link",
            "required": true
        },
        "webCredential": {
            "type": "link",
            "required": true
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "required": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "clinicaNasNuvensSettings"
        },
        "apiCredential": {
            "type": "belongsTo",
            "entity": "Credential",
            "foreign": "clinicaNasNuvensApiSettings"
        },
        "webCredential": {
            "type": "belongsTo",
            "entity": "Credential",
            "foreign": "clinicaNasNuvensWebSettings"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "modifiedAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ]
    },
    "indexes": {
        "tenantId": {
            "columns": ["tenantId"]
        },
        "name": {
            "columns": ["name", "deleted"]
        },
        "apiCredentialId": {
            "columns": ["apiCredentialId"]
        },
        "webCredentialId": {
            "columns": ["webCredentialId"]
        },
        "tenantIsActive": {
            "columns": ["tenantId", "isActive", "deleted"]
        },
        "migrationStatus": {
            "columns": ["migrationStatus", "deleted"]
        }
    }
}
