    "collection": {
        "orderBy": "modifiedAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "agendamentoId",
            "idPaciente",
            "idPessoaExecutor",
            "idTipoConsulta",
            "status",
            "statusFaturamento",
            "profissional",
            "convenio",
            "especialidade",
            "paciente"
        ]
    },
    "indexes": {
        "pacienteId": {
            "columns": ["pacienteId"]
        },
        "profissionalAnchorId": {
            "columns": ["profissionalAnchorId"]
        },
        "credentialId": {
            "columns": ["credentialId"]
        },
        "settingsId": {
            "columns": ["settingsId"]
        },
        "convenioTipoAnchorId": {
            "columns": ["convenioTipoAnchorId"]
        },
        "consultaTipoAnchorId": {
            "columns": ["consultaTipoAnchorId"]
        },
        "agendamentoIdCredential": {
            "unique": true,
            "columns": ["agendamentoId", "credentialId", "deleted"]
        }
    }
