    "links": {
        "paciente": {
            "type": "belongsTo",
            "entity": "FeatureIntegrationClinicaNasNuvensPaciente",
            "foreign": "agendamentos"
        },
        "profissionalAnchor": {
            "type": "belongsTo",
            "entity": "FeatureIntegrationClinicaNasNuvensProfissional",
            "foreign": "agendamentos"
        },
        "convenioTipoAnchor": {
            "type": "belongsTo",
            "entity": "FeatureIntegrationClinicaNasNuvensConvenioTipo",
            "foreign": "agendamentos"
        },
        "consultaTipoAnchor": {
            "type": "belongsTo",
            "entity": "FeatureIntegrationClinicaNasNuvensConsultaTipo",
            "foreign": "agendamentos"
        },
        "credential": {
            "type": "belongsTo",
            "entity": "Credential",
            "foreign": "clinicaNasNuvensAgendamentos"
        },
        "settings": {
            "type": "belongsTo",
            "entity": "FeatureIntegrationClinicaNasNuvensSettings"
        },
        "faturamentos": {
            "type": "hasMany",
            "entity": "FeatureIntegrationClinicaNasNuvensFaturamento",
            "foreign": "agendamento"
        },
        "procedimentoItens": {
            "type": "hasMany",
            "entity": "FeatureIntegrationClinicaNasNuvensAgendamentoProcedimento",
            "foreign": "agendamento"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
