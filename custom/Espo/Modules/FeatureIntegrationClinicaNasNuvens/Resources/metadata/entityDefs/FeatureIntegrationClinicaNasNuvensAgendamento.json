{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 255
        },
        "agendamentoId": {
            "type": "varchar",
            "maxLength": 100,
            "required": true,
            "view": "feature-integration-clinica-nas-nuvens:views/fields/cnn-external-id"
        },
        "paciente": {
            "type": "link"
        },
        "credential": {
            "type": "link"
        },
        "syncStatus": {
            "type": "enum",
            "options": ["pending", "synced", "error"],
            "default": "pending"
        },
        "idPaciente": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "idProfissional": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "idConvenio": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "idEspecialidade": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "idUnidade": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "idSala": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "data": {
            "type": "datetime",
            "readOnly": true
        },
        "horaInicio": {
            "type": "datetime",
            "readOnly": true
        },
        "horaFim": {
            "type": "datetime",
            "readOnly": true
        },
        "status": {
            "type": "enum",
            "options": ["agendado", "confirmado", "atendido", "finalizado", "em_espera", "cancelado", "cancelado_paciente", "falta", "remarcado", "encaixe", "bloqueado"],
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "agendado": "primary",
                "confirmado": "info",
                "atendido": "success",
                "finalizado": "success",
                "em_espera": "warning",
                "cancelado": "danger",
                "cancelado_paciente": "danger",
                "falta": "warning",
                "remarcado": "info",
                "encaixe": "primary",
                "bloqueado": "default"
            },
            "readOnly": true
        },
        "statusFaturamento": {
            "type": "enum",
            "options": ["CANCELADO", "SEM_REGISTRO", "FATURADO"],
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "CANCELADO": "danger",
                "SEM_REGISTRO": "default",
                "FATURADO": "success"
            },
            "readOnly": true
        },
        "tipoAtendimento": {
            "type": "varchar",
            "maxLength": 120,
            "readOnly": true
        },
        "profissional": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "convenio": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "especialidade": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "sala": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "unidade": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "observacao": {
            "type": "text",
            "readOnly": true
        },
        "procedimentos": {
            "type": "jsonArray",
            "view": "views/fields/text",
            "readOnly": true
        },
        "valor": {
            "type": "currency",
            "readOnly": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "required": true
        }
    },
    "links": {
        "paciente": {
            "type": "belongsTo",
            "entity": "FeatureIntegrationClinicaNasNuvensPaciente",
            "foreign": "agendamentos"
        },
        "credential": {
            "type": "belongsTo",
            "entity": "Credential",
            "foreign": "clinicaNasNuvensAgendamentos"
        },
        "faturamentos": {
            "type": "hasMany",
            "entity": "FeatureIntegrationClinicaNasNuvensFaturamento",
            "foreign": "agendamento"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "modifiedAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "agendamentoId",
            "idPaciente",
            "status",
            "statusFaturamento",
            "profissional",
            "convenio",
            "especialidade",
            "paciente"
        ]
    },
    "indexes": {
        "pacienteId": {
            "columns": ["pacienteId"]
        },
        "credentialId": {
            "columns": ["credentialId"]
        },
        "agendamentoIdCredential": {
            "unique": true,
            "columns": ["agendamentoId", "credentialId", "deleted"]
        }
    }
}
