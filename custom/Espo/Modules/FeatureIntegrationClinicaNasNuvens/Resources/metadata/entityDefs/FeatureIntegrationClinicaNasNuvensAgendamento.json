{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 255
        },
        "agendamentoId": {
            "type": "varchar",
            "maxLength": 100,
            "required": true
        },
        "paciente": {
            "type": "link"
        },
        "credential": {
            "type": "link"
        },
        "syncStatus": {
            "type": "enum",
            "options": ["pending", "synced", "error"],
            "default": "pending"
        },
        "idPaciente": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "idProfissional": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "idConvenio": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "idEspecialidade": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "idUnidade": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "idSala": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true
        },
        "data": {
            "type": "date",
            "readOnly": true
        },
        "horaInicio": {
            "type": "varchar",
            "maxLength": 32,
            "readOnly": true
        },
        "horaFim": {
            "type": "varchar",
            "maxLength": 32,
            "readOnly": true
        },
        "status": {
            "type": "enum",
            "options": ["agendado", "confirmado", "atendido", "cancelado", "falta", "remarcado", "encaixe", "bloqueado"],
            "readOnly": true
        },
        "tipoAtendimento": {
            "type": "varchar",
            "maxLength": 120,
            "readOnly": true
        },
        "profissional": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "convenio": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "especialidade": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "sala": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "unidade": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "observacao": {
            "type": "text",
            "readOnly": true
        },
        "procedimentos": {
            "type": "jsonArray",
            "view": "views/fields/text",
            "readOnly": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "paciente": {
            "type": "belongsTo",
            "entity": "FeatureIntegrationClinicaNasNuvensPaciente",
            "foreign": "agendamentos"
        },
        "credential": {
            "type": "belongsTo",
            "entity": "Credential",
            "foreign": "clinicaNasNuvensAgendamentos"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "modifiedAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "agendamentoId",
            "idPaciente",
            "status",
            "profissional",
            "convenio",
            "especialidade",
            "paciente"
        ]
    },
    "indexes": {
        "pacienteId": {
            "columns": ["pacienteId"]
        },
        "credentialId": {
            "columns": ["credentialId"]
        },
        "agendamentoIdCredential": {
            "unique": true,
            "columns": ["agendamentoId", "credentialId", "deleted"]
        }
    }
}
