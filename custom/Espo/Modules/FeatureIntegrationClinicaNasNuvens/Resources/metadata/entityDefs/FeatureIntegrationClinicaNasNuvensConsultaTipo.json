{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 255,
            "readOnlyAfterCreate": true
        },
        "consultaTipoId": {
            "type": "varchar",
            "maxLength": 100,
            "required": true,
            "view": "feature-integration-clinica-nas-nuvens:views/fields/cnn-external-id",
            "readOnlyAfterCreate": true
        },
        "credential": {
            "type": "link",
            "readOnlyAfterCreate": true
        },
        "settings": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true
        },
        "syncStatus": {
            "type": "enum",
            "options": ["pending", "synced", "error"],
            "default": "pending",
            "readOnlyAfterCreate": true
        },
        "ativo": {
            "type": "bool",
            "readOnly": true,
            "readOnlyAfterCreate": true
        },
        "reconsulta": {
            "type": "bool",
            "readOnly": true,
            "readOnlyAfterCreate": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true,
            "readOnlyAfterCreate": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true,
            "readOnlyAfterCreate": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user",
            "readOnlyAfterCreate": true
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user",
            "readOnlyAfterCreate": true
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "required": true,
            "readOnlyAfterCreate": true
        }
    },
    "links": {
        "credential": {
            "type": "belongsTo",
            "entity": "Credential",
            "foreign": "clinicaNasNuvensConsultaTipos"
        },
        "settings": {
            "type": "belongsTo",
            "entity": "FeatureIntegrationClinicaNasNuvensSettings"
        },
        "agendamentos": {
            "type": "hasMany",
            "entity": "FeatureIntegrationClinicaNasNuvensAgendamento",
            "foreign": "consultaTipoAnchor"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "modifiedAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "consultaTipoId",
            "credential"
        ]
    },
    "indexes": {
        "credentialId": {
            "columns": ["credentialId"]
        },
        "settingsId": {
            "columns": ["settingsId"]
        },
        "consultaTipoIdCredential": {
            "unique": true,
            "columns": ["consultaTipoId", "credentialId", "deleted"]
        }
    }
