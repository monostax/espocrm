{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 100,
            "trim": true,
            "pattern": "$noBadCharacters"
        },
        "slug": {
            "type": "varchar",
            "maxLength": 16,
            "readOnly": true,
            "tooltip": true,
            "comment": "Immutable random short code (lowercase base36, generated by GenerateSlug hook). The public redirect path is /api/v1/TrackingLink/go/{slug}."
        },
        "targetUrl": {
            "type": "url",
            "required": true,
            "maxLength": 1024,
            "strip": false,
            "tooltip": true,
            "view": "feature-tracking-event:views/tracking-link/fields/target-url",
            "sanitizerClassNameList": [
                "Espo\\Modules\\FeatureTrackingEvent\\Classes\\FieldSanitizers\\AsciiUrl"
            ],
            "comment": "Destination of the 302 redirect. Fixed at creation by a CRM user - request-time query params are forwarded but can never change the destination (no open-redirect surface). Non-ASCII input is percent-encoded on both client (target-url view) and API (AsciiUrl sanitizer) paths before core url validation."
        },
        "eventCode": {
            "type": "varchar",
            "maxLength": 64,
            "default": "link_clicked",
            "tooltip": true,
            "comment": "TrackingEvent code recorded per click. Normalized/validated by ValidateLink hook against TrackingEventPersister::CODE_PATTERN."
        },
        "isActive": {
            "type": "bool",
            "default": true,
            "tooltip": true,
            "comment": "Inactive links stop redirecting entirely (404), not just recording."
        },
        "shortUrl": {
            "type": "varchar",
            "notStorable": true,
            "readOnly": true,
            "utility": true,
            "view": "feature-tracking-event:views/tracking-link/fields/short-url",
            "tooltip": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "exportDisabled": true,
            "importDisabled": true,
            "directAccessDisabled": true,
            "comment": "Computed client-side: {trackingLinkDomain}/{slug} when the dedicated short domain is configured, else {siteUrl}/api/v1/TrackingLink/go/{slug}."
        },
        "description": {
            "type": "text"
        },
        "totalClicks": {
            "type": "int",
            "default": 0,
            "readOnly": true,
            "tooltip": true,
            "comment": "Convenience counter (atomic +1 per recorded click). The ledger truth lives in TrackingEvent; preview-bot hits are recorded too - dedupe in analytics."
        },
        "lastClickAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "tooltip": true
        },
        "tenant": {
            "type": "link",
            "readOnly": true,
            "tooltip": true,
            "comment": "Derived from teams via Tenant.baseUserTeam (AssignTenantFromTeam hook). Must match the tracking source's tenant (ValidateLink hook)."
        },
        "trackingSource": {
            "type": "link",
            "required": true,
            "tooltip": true,
            "comment": "Source the click events attribute to. Must be same-tenant and not kind=CRM (internal channel). Its allowUnknownEventCode setting gates auto-creation of the eventCode dictionary entry."
        },
        "events": {
            "type": "linkMultiple",
            "readOnly": true,
            "view": "views/fields/link-multiple",
            "layoutDetailDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "importDisabled": true,
            "exportDisabled": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "trackingLinks"
        },
        "trackingSource": {
            "type": "belongsTo",
            "entity": "TrackingSource",
            "foreign": "trackingLinks"
        },
        "events": {
            "type": "hasMany",
            "entity": "TrackingEvent",
            "foreign": "trackingLink"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "slug": { "type": "unique", "columns": ["slug", "deleted"] },
        "isActive": { "columns": ["isActive"] },
        "tenantId": { "columns": ["tenantId"] }
    }
}
