{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 200,
            "readOnly": true,
            "comment": "Human label: '{typeLabel} · {detail}' composed by TrackingEventNameBuilder in the tenant's language (Tenant.language -> instance default). Detail = link name, page title/path, WA phone, opportunity name... Frozen at creation; backfillable via 'php command.php tracking-event:rebuild-names'."
        },
        "code": {
            "type": "varchar",
            "required": true,
            "maxLength": 64,
            "readOnly": true,
            "index": true,
            "comment": "Denormalized from TrackingEventType.code for fast scope-filtered queries."
        },
        "occurredAt": {
            "type": "datetime",
            "required": true,
            "readOnly": true,
            "comment": "When the event happened, as reported by the client."
        },
        "receivedAt": {
            "type": "datetime",
            "required": true,
            "readOnly": true,
            "comment": "When the ingestion endpoint accepted the event (server clock)."
        },
        "url": {
            "type": "varchar",
            "maxLength": 1024,
            "readOnly": true
        },
        "referrer": {
            "type": "varchar",
            "maxLength": 1024,
            "readOnly": true
        },
        "userAgent": {
            "type": "varchar",
            "maxLength": 512,
            "readOnly": true
        },
        "ipAddress": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "tooltip": true,
            "comment": "Public client IP captured by the ingestion endpoint. Honors X-Forwarded-For when source is trusted."
        },
        "anonymousId": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "index": true,
            "tooltip": true,
            "comment": "Opaque visitor id for un-identified traffic. KEPT after stitching: the (anonymousId, contact) pair on stitched rows is the returning-visitor identity map (TrackingEventPersister::resolveContactIdByAnonymousId)."
        },
        "payload": {
            "type": "jsonObject",
            "readOnly": true,
            "comment": "Raw event payload as received. Immutable; do not mutate post-ingest."
        },
        "attribution": {
            "type": "jsonObject",
            "readOnly": true,
            "tooltip": true,
            "comment": "Resolved attribution snapshot (utm_*, click ids, referrer chain) at ingest time. Cached for downstream CAPI/Google Offline Conversions dispatch."
        },
        "value": {
            "type": "float",
            "readOnly": true,
            "tooltip": true,
            "comment": "Monetary value of the event (e.g. order total). Optional."
        },
        "currency": {
            "type": "enum",
            "options": ["", "USD", "EUR", "BRL", "GBP", "MXN", "ARS"],
            "default": "",
            "readOnly": true
        },
        "status": {
            "type": "enum",
            "options": ["Received", "Stitched", "Processed", "Failed", "Skipped"],
            "default": "Received",
            "readOnly": true,
            "style": {
                "Received": "default",
                "Stitched": "info",
                "Processed": "success",
                "Failed": "danger",
                "Skipped": "warning"
            }
        },
        "channel": {
            "type": "enum",
            "options": ["server", "browser"],
            "default": "browser",
            "readOnly": true,
            "tooltip": true,
            "comment": "Trust marker set by the ingester: 'server' = HMAC-verified trusted source; 'browser' = public unsigned source (Website/Mobile). Downstream consumers (e.g. CAPI dispatch) should weight accordingly.",
            "style": {
                "server": "success",
                "browser": "default"
            }
        },
        "errorMessage": {
            "type": "text",
            "readOnly": true
        },
        "trackingSource": {
            "type": "link",
            "required": true,
            "readOnly": true
        },
        "trackingEventType": {
            "type": "link",
            "required": true,
            "readOnly": true
        },
        "trackingLink": {
            "type": "link",
            "readOnly": true,
            "tooltip": true,
            "comment": "Set only for events recorded by the TrackingLink redirect endpoint (link clicks)."
        },
        "contact": {
            "type": "link",
            "readOnly": true,
            "tooltip": true,
            "comment": "Set when the visitor was already identified, resolved as a returning known browser (anonymousId previously stitched), or backfilled by AnonymousStitcher."
        },
        "parent": {
            "type": "linkParent",
            "entityList": ["Lead", "Opportunity", "Contact", "Account", "TrackingEvent"],
            "readOnly": true,
            "tooltip": true,
            "comment": "Polymorphic subject — additional context (e.g. 'Pricing Page View during Opportunity O-123'). For whatsapp_conversation_linked events: the origin click/session TrackingEvent (WhatsAppAttributionLinker's consumption marker)."
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "required": true,
            "readOnly": true,
            "tooltip": "Inherited from the parent TrackingEventType (auto-set by CascadeTeamsFromEventType hook)."
        },
        "tenant": {
            "type": "link",
            "view": "views/fields/link",
            "readOnly": true,
            "tooltip": "Inherited from the parent TrackingEventType (auto-set by CascadeTenantFromEventType hook)."
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "trackingEvents"
        },
        "trackingSource": {
            "type": "belongsTo",
            "entity": "TrackingSource",
            "foreign": "events"
        },
        "trackingEventType": {
            "type": "belongsTo",
            "entity": "TrackingEventType",
            "foreign": "events"
        },
        "trackingLink": {
            "type": "belongsTo",
            "entity": "TrackingLink",
            "foreign": "events"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "trackingEvents"
        },
        "parent": {
            "type": "belongsToParent",
            "entityList": ["Lead", "Opportunity", "Contact", "Account", "TrackingEvent"]
        }
    },
    "collection": {
        "orderBy": "occurredAt",
        "order": "desc"
    },
    "indexes": {
        "code": { "columns": ["code"] },
        "occurredAt": { "columns": ["occurredAt"] },
        "anonymousId": { "columns": ["anonymousId", "deleted"] },
        "anonymousIdOccurredAt": { "columns": ["anonymousId", "occurredAt"] },
        "contactId": { "columns": ["contactId", "deleted"] },
        "contactIdOccurredAt": { "columns": ["contactId", "occurredAt"] },
        "status": { "columns": ["status"] },
        "tenantId": { "columns": ["tenantId", "deleted"] },
        "trackingLinkId": { "columns": ["trackingLinkId", "deleted"] },
        "trackingLinkIdOccurredAt": { "columns": ["trackingLinkId", "occurredAt"] },
        "parent": { "columns": ["parentType", "parentId"] }
    }
}
