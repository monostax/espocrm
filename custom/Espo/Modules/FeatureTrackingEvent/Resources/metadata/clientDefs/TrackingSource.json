                            "value": ["Website", "Mobile"]
                        }
                    ]
                }
            },
            "allowedOrigins": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "kind",
                            "value": "Website"
                        }
                    ]
                },
                "required": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "kind",
