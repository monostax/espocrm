            "action": "receive",
            "sourceId": ":sourceId"
        },
        "noAuth": true
    },
    {
        "route": "/TrackingEvent/receive/:sourceId",
        "method": "options",
        "params": {
            "controller": "TrackingEventReceiver",
            "action": "preflight",
            "sourceId": ":sourceId"
        },
        "noAuth": true
    },
    {
        "route": "/TrackingLink/go/:slug",
