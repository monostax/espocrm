[
    {
        "route": "/VoipWebhook/:accountId",
        "method": "post",
        "params": {
            "controller": "VoipWebhook",
            "action": "receive",
            "accountId": ":accountId"
        },
        "noAuth": true
    },
    {
        "route": "/VoipRecording/:id/stream",
        "method": "get",
        "params": {
            "controller": "VoipRecording",
            "action": "stream",
            "id": ":id"
        }
    }
]
