{
    "fields": {
        "provider": {
            "type": "enum",
            "options": [
                "meta-whatsapp",
                "meta-whatsapp-coexistence",
                "meta-leadads",
                "meta-system-user",
                "google-calendar",
                "google-meet",
                "google-gmail",
                "meta-instagram",
                "other"
            ],
            "default": "other",
            "maxLength": 32
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "importByDefault": true,
            "isCustom": true
        },
        "teamsIds": {
            "type": "jsonArray",
            "notStorable": true
        },
        "teamsNames": {
            "type": "jsonObject",
            "notStorable": true
        },
        "assignedUsers": {
            "type": "linkMultiple",
            "view": "views/fields/assigned-users",
            "importByDefault": true,
            "isCustom": true
        },
        "assignedUsersIds": {
            "type": "jsonArray",
            "notStorable": true
        },
        "assignedUsersNames": {
            "type": "jsonObject",
            "notStorable": true
        }
    },
    "links": {
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "assignedUsers": {
            "type": "hasMany",
            "entity": "User",
            "foreign": "oauthProviders",
            "relationName": "oauthProviderAssignedUser",
            "layoutRelationshipsDisabled": true
        },
        "credentialTypes": {
            "type": "hasMany",
            "entity": "CredentialType",
            "foreign": "oAuthProvider"
        }
    }
}
