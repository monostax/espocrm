{
    "fields": {
        "createdBy": {
            "view": "views/fields/user-with-avatar"
        },
        "modifiedBy": {
            "view": "views/fields/user-with-avatar"
        },
        "stage": {
            "type": "enum",
            "disabled": true,
            "utility": true,
            "layoutListDisabled": true,
            "layoutDetailDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "layoutDefaultSidePanelDisabled": true,
            "layoutAvailabilityList": [],
            "readOnly": true,
            "customizationDisabled": true,
            "importDisabled": true,
            "exportDisabled": true,
            "textFilterDisabled": true,
            "tooltip": true
        },
        "funnel": {
            "type": "link",
            "required": true,
            "audited": true,
            "tooltip": true,
            "entity": "Funnel",
            "view": "views/fields/link"
        },
        "opportunityStage": {
            "type": "link",
            "required": true,
            "audited": true,
            "tooltip": true,
            "entity": "OpportunityStage",
            "view": "global:views/opportunity/fields/opportunity-stage"
        },
        "opportunityStageStyle": {
            "type": "foreign",
            "link": "opportunityStage",
            "field": "style",
            "readOnly": true,
            "notStorable": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true
        },
        "stageName": {
            "type": "varchar",
            "notStorable": true,
            "readOnly": true,
            "layoutListDisabled": true,
            "layoutDetailDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Open",
                "Won",
                "Lost"
            ],
            "default": "Open",
            "readOnly": true,
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "Open": "default",
                "Won": "success",
                "Lost": "danger"
            }
        },
        "followupStatus": {
            "type": "enum",
            "options": [
                "ActionNeeded",
                "FollowupActive",
                "Ended"
            ],
            "default": "ActionNeeded",
            "required": true,
            "audited": true,
            "displayAsLabel": true,
            "labelType": "state",
            "tooltip": true,
            "style": {
                "ActionNeeded": "warning",
                "FollowupActive": "primary",
                "Ended": "default"
            }
        },
        "followupTimer": {
            "type": "datetime",
            "required": false,
            "default": null,
            "minuteStep": 5,
            "tooltip": true
        },
        "followupCount": {
            "type": "int",
            "required": true,
            "default": 0,
            "min": 0,
            "readOnly": true,
            "tooltip": true
        },
        "followupBreakoutLimit": {
            "type": "int",
            "required": true,
            "default": 4,
            "min": 1,
            "audited": true,
            "tooltip": true
        },
        "followupAiAgent": {
            "type": "link",
            "audited": true,
            "tooltip": true,
            "entity": "ChatwootAccountUserMembership"
        },
        "stageProbability": {
            "type": "foreign",
            "link": "opportunityStage",
            "field": "probability",
            "readOnly": true,
            "notStorable": true,
            "layoutListDisabled": true,
            "layoutDetailDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true
        },
        "tenant": {
            "type": "link",
            "required": true,
            "view": "views/fields/link"
        },
        "teams": {
            "type": "linkMultiple",
            "required": true,
            "view": "views/fields/teams"
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user"
        },
        "sourceChannel": {
            "type": "enum",
            "options": [
                "",
                "Outbound",
                "MetaLeadAds",
                "CTWA",
                "TrackingLink",
                "InboundOrganic"
            ],
            "default": "",
            "audited": true,
            "readOnlyAfterCreate": true,
            "tooltip": true
        },
        "sourceTargetList": {
            "type": "link",
            "entity": "TargetList",
            "audited": true,
            "readOnlyAfterCreate": true,
            "tooltip": true
        },
        "customFields": {
            "type": "jsonObject",
            "view": "global:views/fields/custom-fields",
            "tooltip": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true
        }
    },
    "links": {
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "opportunities"
        },
        "funnel": {
            "type": "belongsTo",
            "entity": "Funnel",
            "foreign": "opportunities"
        },
        "opportunityStage": {
            "type": "belongsTo",
            "entity": "OpportunityStage",
            "foreign": "opportunities"
        },
        "followupAiAgent": {
            "type": "belongsTo",
            "entity": "ChatwootAccountUserMembership"
        },
        "sourceTargetList": {
            "type": "belongsTo",
            "entity": "TargetList",
            "foreign": "opportunities"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "indexes": {
        "funnelId": {
            "columns": [
                "funnelId"
            ]
        },
        "tenantId": {
            "columns": [
                "tenantId"
            ]
        },
        "followupTimer": {
            "columns": [
                "followupTimer",
                "deleted"
            ]
        }
    },
    "dynamicLogic": {
        "fields": {
            "followupTimer": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "followupStatus",
                            "value": "FollowupActive"
                        }
                    ]
                },
                "required": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "followupStatus",
                            "value": "FollowupActive"
                        }
                    ]
                }
            }
        }
    }
}
