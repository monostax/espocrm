{
    "fields": {
        "cpf": {
            "type": "varchar",
            "maxLength": 14,
            "trim": true
        },
        "dataNascimento": {
            "type": "date"
        },
        "sexo": {
            "type": "enum",
            "options": ["", "M", "F", "Outro"],
            "default": ""
        },
        "createdBy": {
            "view": "views/fields/user-with-avatar"
        },
        "modifiedBy": {
            "view": "views/fields/user-with-avatar"
        },
        "tenant": {
            "type": "link",
            "required": true,
            "view": "views/fields/link"
        },
        "teams": {
            "type": "linkMultiple",
            "required": true,
            "view": "views/fields/teams"
        }
    },
    "links": {
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "contacts"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "indexes": {
        "cpf": {
            "unique": true,
            "columns": ["cpf", "tenantId", "deleted"]
        },
        "tenantId": {
            "columns": ["tenantId"]
        }
    }
}
