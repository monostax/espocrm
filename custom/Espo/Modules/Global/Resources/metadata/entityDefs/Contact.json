{
    "fields": {
        "crmTags": { "type": "linkMultiple", "view": "global:views/fields/crm-tags", "loaderClassName": "Espo\\Modules\\Global\\Classes\\FieldProcessing\\CrmTagsLoader" },
        "cpf": {
            "type": "varchar",
            "maxLength": 14,
            "trim": true
        },
        "dataNascimento": {
            "type": "date"
        },
        "sexo": {
            "type": "enum",
            "options": ["", "M", "F", "Outro"],
            "default": ""
        },
        "source": {
            "type": "enum",
            "options": [
                "",
                "Call",
                "Email",
                "Existing Customer",
                "Partner",
                "Public Relations",
                "Web Site",
                "Campaign",
                "Meta Lead Ads",
                "Cal.com",
                "Other"
            ],
            "default": "",
            "audited": true
        },
        "tags": {
            "type": "multiEnum",
            "options": [],
            "allowCustomOptions": true,
            "displayAsLabel": true,
            "storeArrayValues": true,
            "tooltip": true
        },
        "createdBy": {
            "view": "views/fields/user-with-avatar"
        },
        "modifiedBy": {
            "view": "views/fields/user-with-avatar"
        },
        "tenant": {
            "type": "link",
            "required": true,
            "view": "views/fields/link"
        },
        "teams": {
            "type": "linkMultiple",
            "required": true,
            "view": "views/fields/teams"
        },
        "customFields": {
            "type": "jsonObject",
            "view": "global:views/fields/custom-fields",
            "tooltip": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true
        }
    },
    "links": {
        "crmTags": { "type": "hasMany", "entity": "CrmTag", "foreign": "contacts", "relationName": "crmTagContact" },
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "contacts"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "indexes": {
        "cpf": {
            "unique": true,
            "columns": ["cpf", "tenantId", "deleted"]
        },
        "tenantId": {
            "columns": ["tenantId"]
        }
    }
}
