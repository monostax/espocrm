{
    "deleteId": true,
    "fields": {
        "name": { "type": "varchar", "required": true, "maxLength": 100, "trim": true, "pattern": "$noBadCharacters" },
        "color": {
            "type": "varchar",
            "maxLength": 7,
            "default": "#3b82f6",
            "pattern": "^(#[0-9a-fA-F]{6}|slate|amber|teal|ruby|blue|iris)$",
            "view": "global:views/crm-tag/fields/color"
        },
        "visibility": { "type": "enum", "options": ["team", "personal"], "default": "team", "notNull": true, "required": true, "readOnlyAfterCreate": true, "view": "global:views/crm-tag/fields/visibility" },
        "ownerUser": { "type": "link", "readOnly": true, "view": "views/fields/user" },
        "nameScope": { "type": "varchar", "maxLength": 32, "default": "team", "notNull": true, "readOnly": true, "utility": true },
        "tenant": { "type": "link", "required": true, "readOnlyAfterCreate": true },
        "teams": { "type": "linkMultiple", "view": "views/fields/teams" },
        "deleteId": { "type": "varchar", "maxLength": 24, "default": "0", "readOnly": true },
        "createdAt": { "type": "datetime", "readOnly": true },
        "modifiedAt": { "type": "datetime", "readOnly": true },
        "createdBy": { "type": "link", "readOnly": true, "view": "views/fields/user" },
        "modifiedBy": { "type": "link", "readOnly": true, "view": "views/fields/user" }
    },
    "links": {
        "ownerUser": { "type": "belongsTo", "entity": "User" },
        "tenant": { "type": "belongsTo", "entity": "Tenant", "foreign": "crmTags" },
        "teams": { "type": "hasMany", "entity": "Team", "relationName": "entityTeam", "layoutRelationshipsDisabled": true },
        "opportunities": { "type": "hasMany", "entity": "Opportunity", "foreign": "tags", "relationName": "crmTagOpportunity", "layoutRelationshipsDisabled": true },
        "tasks": { "type": "hasMany", "entity": "Task", "foreign": "tags", "relationName": "crmTagTask", "layoutRelationshipsDisabled": true },
        "calls": { "type": "hasMany", "entity": "Call", "foreign": "tags", "relationName": "crmTagCall", "layoutRelationshipsDisabled": true },
        "meetings": { "type": "hasMany", "entity": "Meeting", "foreign": "tags", "relationName": "crmTagMeeting", "layoutRelationshipsDisabled": true },
        "createdBy": { "type": "belongsTo", "entity": "User" },
        "modifiedBy": { "type": "belongsTo", "entity": "User" }
    },
    "collection": { "orderBy": "name", "order": "asc" },
    "indexes": {
        "uniqueName": { "columns": ["tenantId", "name", "nameScope", "deleteId"], "unique": true },
        "tenantId": { "columns": ["tenantId"] }
    }
}
