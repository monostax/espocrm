{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 100,
            "trim": true,
            "tooltip": true
        },
        "description": {
            "type": "text"
        },
        "user": {
            "type": "link",
            "required": true,
            "view": "views/fields/user",
            "tooltip": true
        },
        "apiKey": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "textFilterDisabled": true,
            "importDisabled": true,
            "tooltip": true
        },
        "isActive": {
            "type": "bool",
            "default": true,
            "tooltip": true
        },
        "lastUsedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "expiresAt": {
            "type": "datetime",
            "tooltip": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "user": {
            "type": "belongsTo",
            "entity": "User",
            "foreign": "userApiKeys"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "apiKey": {
            "unique": true,
            "columns": ["apiKey", "deleted"]
        },
        "userId": {
            "columns": ["userId", "deleted"]
        },
        "createdAt": {
            "columns": ["createdAt"]
        }
    }
}
