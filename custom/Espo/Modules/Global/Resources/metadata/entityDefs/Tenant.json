{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters",
            "maxLength": 100,
            "trim": true
        },
        "slug": {
            "type": "varchar",
            "required": true,
            "unique": true,
            "maxLength": 60,
            "trim": true,
            "pattern": "^[a-z0-9-]+$",
            "tooltip": true,
            "comment": "Stable, globally-unique URL slug for the tenant. Used to build per-tenant subdomains (e.g. guest.<slug>.<domain>). Format: lowercase letters, digits, hyphens."
        },
        "description": {
            "type": "text"
        },
        "language": {
            "type": "enum",
            "view": "views/preferences/fields/language",
            "tooltip": true,
            "comment": "Tenant default language. Empty = inherit instance default (config 'language'). Used for server-generated text (e.g. TrackingEvent/TrackingEventType names) and copied into Preferences of newly linked users."
        },
        "timeZone": {
            "type": "enum",
            "view": "views/preferences/fields/time-zone",
            "tooltip": true,
            "comment": "Tenant default time zone. Empty = inherit instance default (config 'timeZone'). Copied into Preferences of newly linked users; reserved for future server-side per-tenant formatting."
        },
        "baseUserTeam": {
            "type": "link",
            "view": "views/fields/link"
        },
        "otherUserTeams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "otherUserTeamsIds": {
            "type": "jsonArray",
            "notStorable": true
        },
        "otherUserTeamsNames": {
            "type": "jsonObject",
            "notStorable": true
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "exportDisabled": true,
            "importDisabled": true,
            "tooltip": "Mirrors baseUserTeam for ACL team-level access. Auto-synced."
        },
        "teamsIds": {
            "type": "jsonArray",
            "notStorable": true
        },
        "teamsNames": {
            "type": "jsonObject",
            "notStorable": true
        },
        "users": {
            "type": "linkMultiple",
            "view": "views/fields/assigned-users"
        },
        "usersIds": {
            "type": "jsonArray",
            "notStorable": true
        },
        "usersNames": {
            "type": "jsonObject",
            "notStorable": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "baseUserTeam": {
            "type": "belongsTo",
            "entity": "Team",
            "foreign": "tenantsAsBaseUserTeam"
        },
        "otherUserTeams": {
            "type": "hasMany",
            "entity": "Team",
            "foreign": "tenantsAsOtherUserTeam",
            "relationName": "tenantOtherUserTeam",
            "layoutRelationshipsDisabled": true
        },
        "users": {
            "type": "hasMany",
            "entity": "User",
            "foreign": "tenants",
            "relationName": "tenantUser",
            "layoutRelationshipsDisabled": true
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "contacts": {
            "type": "hasMany",
            "entity": "Contact",
            "foreign": "tenant"
        },
        "accounts": {
            "type": "hasMany",
            "entity": "Account",
            "foreign": "tenant"
        },
        "leads": {
            "type": "hasMany",
            "entity": "Lead",
            "foreign": "tenant"
        },
        "opportunities": {
            "type": "hasMany",
            "entity": "Opportunity",
            "foreign": "tenant"
        },
        "funnels": {
            "type": "hasMany",
            "entity": "Funnel",
            "foreign": "tenant"
        },
        "customFieldGroups": {
            "type": "hasMany",
            "entity": "CustomFieldGroup",
            "foreign": "tenant"
        },
        "customFieldDefs": {
            "type": "hasMany",
            "entity": "CustomFieldDef",
            "foreign": "tenant"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc"
    },
    "indexes": {
        "name": {
            "columns": ["name", "deleted"]
        },
        "slug": {
            "columns": ["slug", "deleted"],
            "unique": true
        },
        "baseUserTeamId": {
            "columns": ["baseUserTeamId"]
        }
    }
}
