                "view": "advanced:views/report/fields/dashlet-select"
            },
            "totalColumn": {
                "type": "enum",
                "options": [],
                "required": true
            },
            "totalLabel": {
                "type": "varchar"
            },
            "countColumn": {
                "type": "enum",
                "options": [],
                "required": true
            },
            "countLabel": {
                "type": "varchar"
            },
            "percentageColumn": {
                "type": "enum",
                "options": []
            },
            "percentageLabel": {
                "type": "varchar"
            },
            "useSiMultiplier": {
                "type": "bool"
            },
            "bindDashboardDateRange": {
                "type": "bool"
            },
            "dashboardDateRangeField": {
                "type": "enum",
                "options": []
            },
            "showFilterInfo": {
                "type": "bool"
            },
            "countLinkEnabled": {
                "type": "bool"
            },
