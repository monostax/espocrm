                        {"name": "totalColumn"},
                        {"name": "totalLabel"}
                    ],
                    [
                        {"name": "countColumn"},
                        {"name": "countLabel"}
                    ],
                    [
                        {"name": "percentageColumn"},
                        {"name": "percentageLabel"}
                    ],
                    [
                        {"name": "useSiMultiplier"}
                    ],
                    [
                        {"name": "bindDashboardDateRange"},
                        {"name": "dashboardDateRangeField"}
                    ],
                    [
                        {"name": "showFilterInfo"},
                        {"name": "countLinkEnabled"}
                    ]
                ]
            }
        ]
    }
