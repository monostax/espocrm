{
    "typeList": [
        "createTask",
        "createRecord",
        "createRelatedRecord",
        "sendEmail",
        "sendWhatsAppMessage",
        "sendWhatsAppTemplate",
        "enrollToWhatsAppCampaign",
        "notifyUser",
        "makeFollowed",
        "updateTarget",
        "updateRelatedRecord",
        "linkRecord",
        "unlinkRecord",
        "applyAssignmentRule",
        "executeFormula",
        "sendHttpRequest",
        "recordTrackingEvent",
        "runScript"
    ],
    "types": {
        "createTask": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\CreateTask",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "name",
                    "type": "varchar",
                    "label": "Task Name",
                    "placeholder": "Follow up with contact"
                },
                {
                    "name": "assignedUserId",
                    "type": "link",
                    "entity": "User",
                    "label": "Assigned User",
                    "nameKey": "assignedUserName"
                },
                {
                    "name": "description",
                    "type": "text",
                    "label": "Description"
                },
                {
                    "name": "status",
                    "type": "enum",
                    "label": "Status",
                    "options": ["Not Started", "Started", "Completed", "Canceled", "Deferred"],
                    "default": "Not Started"
                },
                {
                    "name": "priority",
                    "type": "enum",
                    "label": "Priority",
                    "options": ["Low", "Normal", "High", "Urgent"],
                    "default": "Normal"
                },
                {
                    "name": "dateEnd",
                    "type": "varchar",
                    "label": "Due (YYYY-MM-DD or datetime)",
                    "placeholder": "2026-08-01"
                }
            ]
        },
        "createRecord": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\CreateRecord",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "entityType",
                    "type": "enum",
                    "label": "Record type",
                    "options": ["Task", "Case", "Meeting", "Call", "Opportunity", "Note", "Contact", "Lead", "Account"],
                    "required": true
                },
                {
                    "name": "fields",
                    "type": "fieldMap",
                    "label": "Fields"
                },
                {
                    "name": "linkToTarget",
                    "type": "varchar",
                    "label": "Link name to target (optional)",
                    "placeholder": "parent / contact / account"
                }
            ]
        },
        "createRelatedRecord": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\CreateRelatedRecord",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "link",
                    "type": "varchar",
                    "label": "Relation link on target",
                    "required": true,
                    "placeholder": "opportunities / cases / tasks"
                },
                {
                    "name": "fields",
                    "type": "fieldMap",
                    "label": "Fields"
                }
            ]
        },
        "sendEmail": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\SendEmail",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "inboundEmailId",
                    "type": "link",
                    "entity": "InboundEmail",
                    "label": "Group Email Account",
                    "nameKey": "inboundEmailName"
                },
                {
                    "name": "emailAccountId",
                    "type": "link",
                    "entity": "EmailAccount",
                    "label": "Personal Email Account",
                    "nameKey": "emailAccountName"
                },
                {
                    "name": "emailTemplateId",
                    "type": "emailTemplate",
                    "entity": "EmailTemplate",
                    "label": "Email Template",
                    "nameKey": "emailTemplateName",
                    "primaryFilter": "actual",
                    "managedKeys": [
                        "emailTemplateId",
                        "emailTemplateName"
                    ]
                },
                {
                    "name": "to",
                    "type": "varchar",
                    "label": "To (optional)",
                    "placeholder": "Leave empty = all target emails; or list a,b@x.com"
                },
                {
                    "name": "subject",
                    "type": "varchar",
                    "label": "Subject override"
                },
                {
                    "name": "body",
                    "type": "text",
                    "label": "Body override"
                },
                {
                    "name": "isHtml",
                    "type": "bool",
                    "label": "HTML body",
                    "default": true
                }
            ]
        },
        "sendWhatsAppMessage": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\SendWhatsAppMessage",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "chatwootInboxId",
                    "type": "link",
                    "entity": "ChatwootInbox",
                    "label": "WhatsApp Inbox",
                    "nameKey": "chatwootInboxName",
                    "primaryFilter": "whatsappAll",
                    "required": true
                },
                {
                    "name": "body",
                    "type": "text",
                    "label": "Message body",
                    "required": true
                },
                {
                    "name": "phone",
                    "type": "varchar",
                    "label": "Phone override (optional)",
                    "placeholder": "Leave empty = all target phones; or list"
                },
                {
                    "name": "fallbackTemplateName",
                    "type": "varchar",
                    "label": "Fallback Meta template (Cloud, if 24h closed)",
                    "placeholder": "hello_world"
                },
                {
                    "name": "fallbackTemplateLanguage",
                    "type": "varchar",
                    "label": "Fallback template language",
                    "placeholder": "pt_BR",
                    "default": "pt_BR"
                },
                {
                    "name": "fallbackTemplateCategory",
                    "type": "enum",
                    "label": "Fallback template category",
                    "options": ["UTILITY", "MARKETING", "AUTHENTICATION"],
                    "default": "UTILITY"
                },
                {
                    "name": "fallbackParameterMapping",
                    "type": "json",
                    "label": "Fallback parameter mapping (JSON)",
                    "placeholder": "{\"1\": \"{{firstName}}\"}"
                },
                {
                    "name": "fallbackHeaderMediaUrl",
                    "type": "varchar",
                    "label": "Fallback header media URL"
                },
                {
                    "name": "fallbackHeaderMediaType",
                    "type": "enum",
                    "label": "Fallback header media type",
                    "options": ["", "image", "video", "document"],
                    "default": ""
                }
            ]
        },
        "sendWhatsAppTemplate": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\SendWhatsAppTemplate",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "chatwootInboxId",
                    "type": "link",
                    "entity": "ChatwootInbox",
                    "label": "WhatsApp Inbox (Cloud API)",
                    "nameKey": "chatwootInboxName",
                    "primaryFilter": "whatsappCloudApi",
                    "required": true
                },
                {
                    "name": "templateName",
                    "type": "whatsappTemplate",
                    "label": "WhatsApp template",
                    "required": true,
                    "managedKeys": [
                        "templateName",
                        "templateLanguage",
                        "templateCategory",
                        "parameterMapping",
                        "templateBody",
                        "headerMediaUrl",
                        "headerMediaType"
                    ]
                },
                {
                    "name": "phone",
                    "type": "varchar",
                    "label": "Phone override (optional)",
                    "placeholder": "Leave empty = all target phones; or list"
                }
            ]
        },
        "enrollToWhatsAppCampaign": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\EnrollToWhatsAppCampaign",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "whatsAppCampaignId",
                    "type": "link",
                    "entity": "WhatsAppCampaign",
                    "label": "WhatsApp Campaign",
                    "nameKey": "whatsAppCampaignName",
                    "required": true
                },
                {
                    "name": "phone",
                    "type": "varchar",
                    "label": "Phone override (optional)",
                    "placeholder": "Leave empty = all target phones; or list"
                }
            ]
        },
        "notifyUser": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\NotifyUser",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "userId",
                    "type": "link",
                    "entity": "User",
                    "label": "User",
                    "nameKey": "userName"
                },
                {
                    "name": "message",
                    "type": "text",
                    "label": "Message",
                    "required": true
                }
            ]
        },
        "makeFollowed": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\MakeFollowed",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "userIds",
                    "type": "json",
                    "label": "Follower user IDs (JSON array)",
                    "required": true,
                    "placeholder": "[\"userId1\", \"userId2\"]"
                }
            ]
        },
        "executeFormula": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\ExecuteFormula",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "hasFormulaField": true,
            "paramDefs": []
        },
        "updateTarget": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\UpdateTarget",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "fields",
                    "type": "fieldMap",
                    "label": "Fields to update"
                }
            ]
        },
        "updateRelatedRecord": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\UpdateRelatedRecord",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "link",
                    "type": "varchar",
                    "label": "Relation link on target",
                    "required": true
                },
                {
                    "name": "fields",
                    "type": "fieldMap",
                    "label": "Fields to update"
                },
                {
                    "name": "relatedId",
                    "type": "varchar",
                    "label": "Related record id (optional single)"
                },
                {
                    "name": "parentEntityType",
                    "type": "varchar",
                    "label": "Parent entity type filter (optional)"
                }
            ]
        },
        "linkRecord": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\LinkRecord",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "link",
                    "type": "varchar",
                    "label": "Relation link on target",
                    "required": true
                },
                {
                    "name": "entityId",
                    "type": "varchar",
                    "label": "Foreign record id",
                    "required": true
                }
            ]
        },
        "unlinkRecord": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\UnlinkRecord",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "link",
                    "type": "varchar",
                    "label": "Relation link on target",
                    "required": true
                },
                {
                    "name": "entityId",
                    "type": "varchar",
                    "label": "Foreign record id (required for multi links)"
                }
            ]
        },
        "applyAssignmentRule": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\ApplyAssignmentRule",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "assignmentRule",
                    "type": "enum",
                    "label": "Rule",
                    "options": ["Round-Robin", "Least-Busy"],
                    "default": "Round-Robin",
                    "required": true
                },
                {
                    "name": "targetTeamId",
                    "type": "link",
                    "entity": "Team",
                    "label": "Team (must be in workspace)",
                    "nameKey": "targetTeamName",
                    "required": true
                },
                {
                    "name": "targetUserPosition",
                    "type": "varchar",
                    "label": "Team role / position (optional)"
                }
            ]
        },
        "sendHttpRequest": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\SendHttpRequest",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "requestUrl",
                    "type": "varchar",
                    "label": "URL (must match allow-list prefix)",
                    "required": true,
                    "placeholder": "https://hooks.example.com/journey"
                },
                {
                    "name": "requestType",
                    "type": "enum",
                    "label": "Method",
                    "options": ["GET", "POST", "PUT", "PATCH"],
                    "default": "POST"
                },
                {
                    "name": "contentType",
                    "type": "enum",
                    "label": "Content-Type",
                    "options": ["", "application/json", "application/x-www-form-urlencoded"],
                    "default": "application/json"
                },
                {
                    "name": "content",
                    "type": "text",
                    "label": "Body (supports {$field} tokens)"
                },
                {
                    "name": "headers",
                    "type": "json",
                    "label": "Extra headers (JSON string array)"
                }
            ]
        },
        "runScript": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\RunScript",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "platform",
            "paramDefs": [
                {
                    "name": "className",
                    "type": "varchar",
                    "label": "Script class",
                    "required": true
                }
            ]
        },
        "recordTrackingEvent": {
            "implementationClassName": "Espo\\Modules\\FeatureJourney\\Classes\\JourneyActions\\RecordTrackingEvent",
            "paramsView": "feature-journey:views/journey-stage-action/fields/params",
            "tier": "tenant",
            "paramDefs": [
                {
                    "name": "code",
                    "type": "varchar",
                    "label": "Event code",
                    "required": true,
                    "placeholder": "pricing_viewed"
                },
                {
                    "name": "properties",
                    "type": "json",
                    "label": "Properties (optional JSON)"
                }
            ]
        }
    }
}
