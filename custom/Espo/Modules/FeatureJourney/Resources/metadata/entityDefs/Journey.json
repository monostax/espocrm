{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 255,
            "link": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Draft",
                "Active",
                "Paused",
                "Completed",
                "Archived"
            ],
            "default": "Draft",
            "style": {
                "Draft": null,
                "Active": "success",
                "Paused": "warning",
                "Completed": "primary",
                "Archived": "default"
            },
            "readOnly": true
        },
        "targetEntityType": {
            "type": "enum",
            "options": [
                "Contact",
                "Account",
                "Lead"
            ],
            "required": true,
            "default": "Contact"
        },
        "tenant": {
            "type": "link",
            "view": "views/fields/link",
            "readOnly": true
        },
        "targetLists": {
            "type": "linkMultiple"
        },
        "manualContacts": {
            "type": "linkMultiple"
        },
        "excludeTargetLists": {
            "type": "linkMultiple"
        },
        "continuousEnrollment": {
            "type": "bool",
            "default": false
        },
        "allowReEnrollment": {
            "type": "bool",
            "default": false,
            "tooltip": true
        },
        "goalEventCodes": {
            "type": "multiEnum",
            "allowCustomOptions": true,
            "options": []
        },
        "goalEntityFilter": {
            "type": "jsonObject",
            "view": "feature-journey:views/fields/entity-where",
            "tooltip": true
        },
        "goalSuccessStage": {
            "type": "link",
            "view": "feature-journey:views/journey/fields/goal-success-stage",
            "tooltip": true
        },
        "activeCount": {
            "type": "int",
            "readOnly": true,
            "default": 0
        },
        "completedCount": {
            "type": "int",
            "readOnly": true,
            "default": 0
        },
        "exitedCount": {
            "type": "int",
            "readOnly": true,
            "default": 0
        },
        "goalCount": {
            "type": "int",
            "readOnly": true,
            "default": 0
        },
        "activatedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "completedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "runAsUser": {
            "type": "link",
            "view": "global:views/fields/run-as-user",
            "tooltip": true
        },
        "teams": {
            "type": "linkMultiple",
            "required": true,
            "view": "views/fields/teams"
        },
        "stages": {
            "type": "linkMultiple",
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true
        },
        "transitions": {
            "type": "linkMultiple",
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true
        },
        "records": {
            "type": "linkMultiple",
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true
        }
    },
    "links": {
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "journeys"
        },
        "targetLists": {
            "type": "hasMany",
            "entity": "TargetList",
            "foreign": "journeys",
            "relationName": "journeyTargetList"
        },
        "manualContacts": {
            "type": "hasMany",
            "entity": "Contact",
            "foreign": "journeysManual",
            "relationName": "journeyManualContact"
        },
        "excludeTargetLists": {
            "type": "hasMany",
            "entity": "TargetList",
            "foreign": "journeysExcluding",
            "relationName": "journeyTargetListExcluding"
        },
        "goalSuccessStage": {
            "type": "belongsTo",
            "entity": "JourneyStage"
        },
        "stages": {
            "type": "hasMany",
            "entity": "JourneyStage",
            "foreign": "journey"
        },
        "transitions": {
            "type": "hasMany",
            "entity": "JourneyTransition",
            "foreign": "journey"
        },
        "records": {
            "type": "hasMany",
            "entity": "JourneyRecord",
            "foreign": "journey"
        },
        "runAsUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "status": {
            "columns": [
                "status",
                "deleted"
            ]
        },
        "tenantId": {
            "columns": [
                "tenantId",
                "deleted"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "cascadeDelete": {
        "links": [
            "records",
            "transitions",
            "stages"
        ],
        "junctionTables": [
            {
                "table": "JourneyTargetList",
                "column": "journeyId"
            },
            {
                "table": "JourneyManualContact",
                "column": "journeyId"
            },
            {
                "table": "JourneyTargetListExcluding",
                "column": "journeyId"
            }
        ]
    }
}
