{
    "fields": {
        "name": {
            "type": "varchar",
            "maxLength": 200,
            "readOnly": true,
            "comment": "Derived: '<eventName> · <sourceId>'."
        },
        "eventName": {
            "type": "enum",
            "options": ["Purchase", "LeadSubmitted", "AddToCart", "InitiateCheckout", "ViewContent", "Contact", "Other"],
            "default": "Purchase",
            "readOnly": true,
            "index": true
        },
        "channel": {
            "type": "enum",
            "options": ["whatsapp", "instagram"],
            "default": "whatsapp",
            "readOnly": true,
            "style": {
                "whatsapp": "success",
                "instagram": "info"
            }
        },
        "ctwaClid": {
            "type": "varchar",
            "maxLength": 512,
            "readOnly": true,
            "tooltip": true,
            "comment": "WhatsApp-only attribution key: the Click-to-WhatsApp click id (ctwa_clid). Empty for Instagram rows."
        },
        "igSid": {
            "type": "varchar",
            "maxLength": 256,
            "readOnly": true,
            "tooltip": true,
            "comment": "Instagram-only attribution key: the Instagram-scoped sender id (IGSID). Empty for WhatsApp rows."
        },
        "sourceId": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "index": true,
            "comment": "Messaging account id: WABA id (WhatsApp) or Instagram business account id (Instagram). Joins to MetaCapiDatasetSource.sourceId."
        },
        "wamid": {
            "type": "varchar",
            "maxLength": 256,
            "readOnly": true,
            "tooltip": true,
            "comment": "Idempotency / dedup key (one row per key). For real conversions it is the provider message id (WhatsApp wamid / Instagram message id). For ad-arrival rows it is a synthetic key derived from the attribution: 'ctwa:<clid>' (WhatsApp) or 'igsid:<sid>' (Instagram). NEVER sent to Meta."
        },
        "value": {
            "type": "float",
            "readOnly": true
        },
        "currency": {
            "type": "varchar",
            "maxLength": 8,
            "readOnly": true
        },
        "eventTime": {
            "type": "datetime",
            "readOnly": true,
            "index": true
        },
        "rawPayload": {
            "type": "jsonObject",
            "readOnly": true,
            "comment": "The raw conversion entry as received from Chatwoot additional_attributes.ctwa.conversions[]."
        },
        "metaCapiDataset": {
            "type": "link",
            "readOnly": true
        },
        "contact": {
            "type": "link",
            "readOnly": true
        },
        "opportunity": {
            "type": "link",
            "readOnly": true
        },
        "chatwootConversation": {
            "type": "link",
            "readOnly": true
        },
        "conversationName": {
            "type": "foreign",
            "link": "chatwootConversation",
            "field": "name",
            "readOnly": true,
            "notStorable": true,
            "comment": "Foreign read-through of ChatwootConversation.name (e.g. the contact/person name). NOT stored on this row — resolved via a JOIN at query time. Gives a stable, always-current human label for the event without denormalising or back-filling the (often late-reconciled) Contact."
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "required": true,
            "readOnly": true,
            "tooltip": "Inherited from the resolved tenant/source."
        },
        "tenant": {
            "type": "link",
            "view": "views/fields/link",
            "readOnly": true
        }
    },
    "links": {
        "metaCapiDataset": {
            "type": "belongsTo",
            "entity": "MetaCapiDataset"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact"
        },
        "opportunity": {
            "type": "belongsTo",
            "entity": "Opportunity"
        },
        "chatwootConversation": {
            "type": "belongsTo",
            "entity": "ChatwootConversation"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "metaConversionEvents"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "wamidUnique": {
            "type": "unique",
            "columns": ["wamid", "deleted"]
        },
        "eventTime": {
            "columns": ["eventTime"]
        },
        "tenantId": {
            "columns": ["tenantId", "deleted"]
        }
    }
}
