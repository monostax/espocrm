{
    "fields": {
        "emailCampaign": {
            "type": "link",
            "required": true
        },
        "contact": {
            "type": "link",
            "required": true
        },
        "emailAddress": {
            "type": "varchar",
            "maxLength": 255,
            "required": true
        },
        "contactName": {
            "type": "varchar",
            "maxLength": 255
        },
        "status": {
            "type": "enum",
            "options": [
                "Pending",
                "Processing",
                "Retry",
                "Sent",
                "Failed",
                "OptedOut",
                "Bounced"
            ],
            "default": "Pending",
            "style": {
                "Pending": null,
                "Processing": "primary",
                "Retry": "warning",
                "Sent": "success",
                "Failed": "danger",
                "OptedOut": "default",
                "Bounced": "warning"
            }
        },
        "claimedAt": {
            "type": "datetime",
            "readOnly": true,
            "tooltip": true
        },
        "sentAt": {
            "type": "datetime",
            "readOnly": true
        },
        "failedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "failedReason": {
            "type": "text",
            "readOnly": true
        },
        "retryCount": {
            "type": "int",
            "default": 0,
            "readOnly": true
        },
        "emailId": {
            "type": "varchar",
            "maxLength": 17,
            "readOnly": true
        },
        "targetLists": {
            "type": "linkMultiple",
            "readOnly": true
        },
        "opportunity": {
            "type": "link",
            "readOnly": true
        },
        "opportunityAttributionStatus": {
            "type": "enum",
            "options": ["NotRequested", "Pending", "Linked", "Failed"],
            "default": "NotRequested",
            "readOnly": true,
            "style": {
                "NotRequested": null,
                "Pending": "warning",
                "Linked": "success",
                "Failed": "danger"
            }
        },
        "opportunityAttributionAction": {
            "type": "enum",
            "options": ["", "Created", "Reused"],
            "default": "",
            "readOnly": true
        },
        "opportunityAttributionError": {
            "type": "text",
            "readOnly": true
        },
        "opportunityAttributionStage": {
            "type": "link",
            "readOnly": true,
            "tooltip": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "emailCampaign": {
            "type": "belongsTo",
            "entity": "EmailCampaign",
            "foreign": "campaignContacts"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact"
        },
        "targetLists": {
            "type": "hasMany",
            "entity": "TargetList",
            "foreign": "emailCampaignContacts",
            "relationName": "emailCampaignContactTargetList"
        },
        "opportunity": {
            "type": "belongsTo",
            "entity": "Opportunity",
            "foreign": "emailCampaignContacts"
        },
        "opportunityAttributionStage": {
            "type": "belongsTo",
            "entity": "OpportunityStage"
        }
    },
    "indexes": {
        "campaignStatus": {
            "columns": ["emailCampaignId", "status"]
        },
        "statusClaimedAt": {
            "columns": ["status", "claimedAt"]
        },
        "contactCampaign": {
            "columns": ["contactId", "emailCampaignId"]
        },
        "emailCampaignAddress": {
            "columns": ["emailCampaignId", "emailAddress"],
            "unique": true
        },
        "opportunityId": {
            "columns": ["opportunityId"]
        },
        "opportunityAttributionStatus": {
            "columns": ["opportunityAttributionStatus"]
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    }
}
