{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 255,
            "link": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Draft",
                "Scheduled",
                "Sending",
                "Completed",
                "Cancelled",
                "Paused"
            ],
            "default": "Draft",
            "readOnly": true,
            "style": {
                "Draft": null,
                "Scheduled": "primary",
                "Sending": "warning",
                "Completed": "success",
                "Cancelled": "danger",
                "Paused": "default"
            }
        },
        "emailTemplate": {
            "type": "link",
            "required": true,
            "createButton": true
        },
        "fromAddress": {
            "type": "varchar",
            "view": "crm:views/mass-email/fields/from-address"
        },
        "fromName": {
            "type": "varchar"
        },
        "replyToAddress": {
            "type": "varchar"
        },
        "replyToName": {
            "type": "varchar"
        },
        "inboundEmail": {
            "type": "link",
            "tooltip": true
        },
        "emailAccount": {
            "type": "link",
            "tooltip": true
        },
        "storeSentEmails": {
            "type": "bool",
            "default": false,
            "tooltip": true
        },
        "tenant": {
            "type": "link",
            "view": "views/fields/link",
            "readOnly": true,
            "tooltip": true
        },
        "targetLists": {
            "type": "linkMultiple"
        },
        "excludeCampaigns": {
            "type": "linkMultiple",
            "tooltip": true
        },
        "excludingTargetLists": {
            "type": "linkMultiple",
            "tooltip": true
        },
        "manualContacts": {
            "type": "linkMultiple"
        },
        "continuousEnrollment": {
            "type": "bool",
            "default": false,
            "tooltip": true
        },
        "createOpportunity": {
            "type": "bool",
            "default": false,
            "tooltip": true
        },
        "funnel": {
            "type": "link",
            "entity": "Funnel",
            "tooltip": true
        },
        "opportunityStage": {
            "type": "link",
            "entity": "OpportunityStage",
            "view": "global:views/opportunity/fields/opportunity-stage",
            "tooltip": true
        },
        "opportunityAssignedUser": {
            "type": "link",
            "entity": "User",
            "view": "views/fields/assigned-user",
            "tooltip": true
        },
        "opportunities": {
            "type": "linkMultiple",
            "readOnly": true
        },
        "scheduledAt": {
            "type": "datetime"
        },
        "startedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "completedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "sentCount": {
            "type": "int",
            "readOnly": true,
            "default": 0
        },
        "failedCount": {
            "type": "int",
            "readOnly": true,
            "default": 0
        },
        "bouncedCount": {
            "type": "int",
            "readOnly": true,
            "default": 0
        },
        "optedOutCount": {
            "type": "int",
            "readOnly": true,
            "default": 0
        },
        "skippedCount": {
            "type": "int",
            "readOnly": true,
            "default": 0,
            "tooltip": true
        },
        "totalRecipients": {
            "type": "int",
            "readOnly": true,
            "default": 0
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "emailTemplate": {
            "type": "belongsTo",
            "entity": "EmailTemplate"
        },
        "inboundEmail": {
            "type": "belongsTo",
            "entity": "InboundEmail"
        },
        "emailAccount": {
            "type": "belongsTo",
            "entity": "EmailAccount"
        },
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "emailCampaigns"
        },
        "targetLists": {
            "type": "hasMany",
            "entity": "TargetList",
            "foreign": "emailCampaigns",
            "relationName": "emailCampaignTargetList"
        },
        "manualContacts": {
            "type": "hasMany",
            "entity": "Contact",
            "foreign": "emailCampaignsManual",
            "relationName": "emailCampaignManualContact"
        },
        "excludeCampaigns": {
            "type": "hasMany",
            "entity": "EmailCampaign",
            "foreign": "excludedByCampaigns",
            "relationName": "emailCampaignExcludeCampaign",
            "midKeys": ["emailCampaignId", "excludeEmailCampaignId"]
        },
        "excludedByCampaigns": {
            "type": "hasMany",
            "entity": "EmailCampaign",
            "foreign": "excludeCampaigns",
            "relationName": "emailCampaignExcludeCampaign",
            "midKeys": ["excludeEmailCampaignId", "emailCampaignId"],
            "layoutRelationshipsDisabled": true
        },
        "excludingTargetLists": {
            "type": "hasMany",
            "entity": "TargetList",
            "foreign": "emailCampaignsExcluding",
            "relationName": "emailCampaignTargetListExcluding"
        },
        "campaignContacts": {
            "type": "hasMany",
            "entity": "EmailCampaignContact",
            "foreign": "emailCampaign"
        },
        "funnel": {
            "type": "belongsTo",
            "entity": "Funnel"
        },
        "opportunityStage": {
            "type": "belongsTo",
            "entity": "OpportunityStage"
        },
        "opportunityAssignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "opportunities": {
            "type": "hasMany",
            "entity": "Opportunity",
            "foreign": "emailCampaigns",
            "relationName": "emailCampaignOpportunity"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "status": {
            "columns": ["status", "deleted"]
        },
        "scheduledAt": {
            "columns": ["scheduledAt", "deleted"]
        },
        "createdAt": {
            "columns": ["createdAt"]
        },
        "createdAtId": {
            "unique": true,
            "columns": ["createdAt", "id"]
        },
        "tenantId": {
            "columns": ["tenantId", "deleted"]
        }
    }
}
