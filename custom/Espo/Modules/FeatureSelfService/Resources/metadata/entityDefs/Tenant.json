{
    "fields": {
        "plan": {
            "type": "enum",
            "options": ["", "monostax", "basic", "advanced", "professional"],
            "default": "",
            "readOnly": true,
            "massUpdateDisabled": true,
            "importDisabled": true,
            "customizationDisabled": true
        },
        "subscriptionStatus": {
            "type": "enum",
            "options": ["", "trial", "active", "pastDue", "frozen"],
            "default": "",
            "readOnly": true,
            "massUpdateDisabled": true,
            "importDisabled": true,
            "customizationDisabled": true
        },
        "onboardingStep": {
            "type": "enum",
            "options": ["", "connectWhatsapp", "importHistory", "done"],
            "default": "",
            "readOnly": true,
            "massUpdateDisabled": true,
            "importDisabled": true,
            "customizationDisabled": true
        },
        "channelConnectedAt": { "type": "datetime", "readOnly": true, "customizationDisabled": true },
        "trialStartsAt": { "type": "datetime", "readOnly": true, "customizationDisabled": true },
        "trialEndsAt": { "type": "datetime", "readOnly": true, "customizationDisabled": true },
        "frozenAt": { "type": "datetime", "readOnly": true, "customizationDisabled": true },
        "seats": { "type": "int", "min": 0, "readOnly": true, "customizationDisabled": true },
        "paidThrough": { "type": "datetime", "readOnly": true, "customizationDisabled": true },
        "chatwootAccess": {
            "type": "varchar",
            "maxLength": 16,
            "readOnly": true,
            "massUpdateDisabled": true,
            "importDisabled": true,
            "customizationDisabled": true,
            "tooltip": true
        },
        "signupJob": {
            "type": "enum",
            "options": ["", "whatsapp", "agente", "funil"],
            "default": "",
            "readOnly": true,
            "massUpdateDisabled": true,
            "importDisabled": true,
            "customizationDisabled": true,
            "tooltip": true
        },
        "signupConnect": {
            "type": "enum",
            "options": ["", "api", "qr"],
            "default": "",
            "readOnly": true,
            "massUpdateDisabled": true,
            "importDisabled": true,
            "customizationDisabled": true
        },
        "signupAttribution": {
            "type": "jsonObject",
            "readOnly": true,
            "massUpdateDisabled": true,
            "importDisabled": true,
            "customizationDisabled": true,
            "tooltip": true
        },
        "workspaceStatus": {
            "type": "enum",
            "options": ["", "onboarding", "trial", "active", "pastDue", "frozenAfterTrial", "frozenUnpaid", "frozen", "managed"],
            "style": {
                "onboarding": "info",
                "trial": "primary",
                "active": "success",
                "pastDue": "warning",
                "frozenAfterTrial": "danger",
                "frozenUnpaid": "danger",
                "frozen": "danger"
            },
            "displayAsLabel": true,
            "notStorable": true,
            "readOnly": true,
            "massUpdateDisabled": true,
            "importDisabled": true,
            "customizationDisabled": true,
            "tooltip": true,
            "select": {
                "select": "SWITCH:(OR:(IS_NULL:(plan), EQUAL:(plan, '')), 'managed', EQUAL:(subscriptionStatus, 'active'), 'active', EQUAL:(subscriptionStatus, 'pastDue'), 'pastDue', AND:(EQUAL:(subscriptionStatus, 'frozen'), IS_NOT_NULL:(paidThrough)), 'frozenUnpaid', AND:(EQUAL:(subscriptionStatus, 'frozen'), IS_NOT_NULL:(trialEndsAt)), 'frozenAfterTrial', EQUAL:(subscriptionStatus, 'frozen'), 'frozen', OR:(EQUAL:(onboardingStep, 'connectWhatsapp'), EQUAL:(onboardingStep, 'importHistory')), 'onboarding', EQUAL:(subscriptionStatus, 'trial'), 'trial', '')"
            },
            "order": {
                "order": [["POSITION_IN_LIST:(workspaceStatus, 'onboarding', 'trial', 'active', 'pastDue', 'frozenAfterTrial', 'frozenUnpaid', 'frozen', 'managed')", "{direction}"]]
            },
            "where": {
                "=": {"whereClause": {"COALESCE:(workspaceStatus, '')": "{value}"}},
                "<>": {"whereClause": {"COALESCE:(workspaceStatus, '')!=": "{value}"}},
                "IN": {"whereClause": {"COALESCE:(workspaceStatus, '')": "{value}"}},
                "NOT IN": {"whereClause": {"COALESCE:(workspaceStatus, '')!=": "{value}"}},
                "IS NULL": {"whereClause": {"COALESCE:(workspaceStatus, '')": ""}},
                "IS NOT NULL": {"whereClause": {"COALESCE:(workspaceStatus, '')!=": ""}}
            }
        }
    }
}
