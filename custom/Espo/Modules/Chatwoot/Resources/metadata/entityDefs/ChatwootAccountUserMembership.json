{
    "deleteId": true,
    "fields": {
        "deleteId": {
            "type": "varchar",
            "maxLength": 17,
            "default": "0",
            "readOnly": true
        },
        "name": {
            "type": "varchar",
            "maxLength": 255,
            "required": true
        },
        "chatwootAccount": {
            "type": "link",
            "required": true
        },
        "chatwootUser": {
            "type": "link",
            "required": true
        },
        "role": {
            "type": "enum",
            "options": ["agent", "administrator"],
            "default": "agent",
            "required": true
        },
        "email": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "availableName": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "availabilityStatus": {
            "type": "enum",
            "options": ["available", "busy", "offline"],
            "default": "offline",
            "readOnly": true
        },
        "autoOffline": {
            "type": "bool",
            "default": true,
            "readOnly": true
        },
        "confirmed": {
            "type": "bool",
            "default": false,
            "readOnly": true
        },
        "avatarUrl": {
            "type": "url",
            "readOnly": true
        },
        "customRoleId": {
            "type": "int",
            "readOnly": true
        },
        "isAI": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "tooltip": true
        },
        "aiPrompt": {
            "type": "wysiwyg",
            "tooltip": true,
            "audited": true
        },
        "ignoreGroups": {
            "type": "bool",
            "default": false
        },
        "ignoreStatusBroadcast": {
            "type": "bool",
            "default": false
        },
        "contextualTransferIsEnabled": {
            "type": "bool",
            "default": false
        },
        "transferScenarios": {
            "type": "text",
            "rowsMin": 10
        },
        "knowledgeBaseCategories": {
            "type": "linkMultiple",
            "tooltip": true
        },
        "calendarsToManage": {
            "type": "linkMultiple",
            "tooltip": true
        },
        "chatwootTeams": {
            "type": "linkMultiple"
        },
        "syncStatus": {
            "type": "enum",
            "options": ["pending", "synced", "error"],
            "default": "pending"
        },
        "lastSyncedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "lastSyncError": {
            "type": "text",
            "readOnly": true
        },
        "chatwootAccountUserId": {
            "type": "int",
            "readOnly": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "required": true,
            "readOnly": true
        },
        "chatwootInboxes": {
            "type": "linkMultiple"
        }
    },
    "links": {
        "chatwootAccount": {
            "type": "belongsTo",
            "entity": "ChatwootAccount",
            "foreign": "accountUserMemberships"
        },
        "chatwootUser": {
            "type": "belongsTo",
            "entity": "ChatwootUser",
            "foreign": "accountUserMemberships"
        },
        "chatwootTeams": {
            "type": "hasMany",
            "entity": "ChatwootTeam",
            "relationName": "chatwootAccountUserMembershipChatwootTeam",
            "foreign": "accountUserMemberships"
        },
        "knowledgeBaseCategories": {
            "type": "hasMany",
            "entity": "KnowledgeBaseCategory",
            "relationName": "chatwootAccountUserMembershipKnowledgeBaseCategory",
            "foreign": "accountUserMemberships"
        },
        "calendarsToManage": {
            "type": "hasMany",
            "entity": "User",
            "relationName": "chatwootAccountUserMembershipCalendarUser",
            "foreign": "accountUserMembershipsWithCalendarAccess"
        },
        "wahaSessionLabels": {
            "type": "hasMany",
            "entity": "WahaSessionLabel",
            "foreign": "accountUserMembership"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "chatwootInboxes": {
            "type": "hasMany",
            "entity": "ChatwootInbox",
            "relationName": "chatwootAccountUserMembershipChatwootInbox",
            "foreign": "accountUserMemberships"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "uniqueMembership": {
            "unique": true,
            "columns": ["chatwootAccountId", "chatwootUserId", "deleteId"]
        },
        "chatwootAccountId": {
            "columns": ["chatwootAccountId"]
        },
        "chatwootUserId": {
            "columns": ["chatwootUserId"]
        },
        "createdAt": {
            "columns": ["createdAt"]
        },
        "createdAtId": {
            "unique": true,
            "columns": ["createdAt", "id"]
        }
    },
    "cascadeDelete": {
        "junctionTables": [
            {"table": "ChatwootAccountUserMembershipChatwootInbox", "column": "chatwootAccountUserMembershipId"},
            {"table": "ChatwootAccountUserMembershipChatwootTeam", "column": "chatwootAccountUserMembershipId"},
            {"table": "ChatwootAccountUserMembershipKnowledgeBaseCategory", "column": "chatwootAccountUserMembershipId"},
            {"table": "ChatwootAccountUserMembershipCalendarUser", "column": "chatwootAccountUserMembershipId"}
        ]
    }
}
