{
    "deleteId": true,
    "fields": {
        "deleteId": {
            "type": "varchar",
            "maxLength": 17,
            "default": "0",
            "readOnly": true
        },
        "name": {
            "type": "varchar",
            "maxLength": 255,
            "required": true
        },
        "chatwootAccount": {
            "type": "link",
            "required": true
        },
        "chatwootUser": {
            "type": "link",
            "required": true
        },
        "role": {
            "type": "enum",
            "options": ["agent", "administrator"],
            "default": "agent",
            "required": true
        },
        "globalAdmin": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "tooltip": true
        },
        "email": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "availableName": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "availabilityStatus": {
            "type": "enum",
            "options": ["available", "busy", "offline"],
            "default": "offline",
            "readOnly": true
        },
        "autoOffline": {
            "type": "bool",
            "default": true,
            "readOnly": true
        },
        "confirmed": {
            "type": "bool",
            "default": false,
            "readOnly": true
        },
        "avatarUrl": {
            "type": "text",
            "readOnly": true
        },
        "customRoleId": {
            "type": "int",
            "readOnly": true
        },
        "isAI": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "tooltip": true
        },
        "aiPrompt": {
            "type": "wysiwyg",
            "tooltip": true,
            "audited": true
        },
        "timeZone": {
            "type": "enum",
            "view": "views/preferences/fields/time-zone",
            "tooltip": true,
            "audited": true,
            "comment": "IANA timezone of this AI agent. Used for conversation-history timestamps and Current Date/Time in prompts (empty = UTC)."
        },
        "ignoreGroups": {
            "type": "bool",
            "default": false
        },
        "ignoreStatusBroadcast": {
            "type": "bool",
            "default": false
        },
        "contextualTransferIsEnabled": {
            "type": "bool",
            "default": false
        },
        "followupsEnabled": {
            "type": "bool",
            "default": true,
            "tooltip": true
        },
        "followupBreakoutLimit": {
            "type": "int",
            "min": 1,
            "tooltip": true,
            "audited": true,
            "comment": "Agent-level default for the per-deal follow-up breakout limit. Empty = non-deterministic: each deal keeps its own value or falls back to the server constant (3); the AI may choose per opportunity."
        },
        "delegateEnabled": {
            "type": "bool",
            "default": false,
            "tooltip": true
        },
        "aiDebounceSeconds": {
            "type": "int",
            "default": 1,
            "min": 0,
            "max": 300,
            "notNull": true,
            "tooltip": true,
            "audited": true
        },
        "whatsappMessageTemplates": {
            "type": "jsonArray",
            "tooltip": true,
            "view": "chatwoot:views/account-user-membership/fields/whatsapp-message-templates",
            "comment": "Allow-list of WhatsApp Cloud/Coexistence message templates this AI may send (name+language+inbox). Used by send_message_template when the 24h session window is closed."
        },
        "transferScenarios": {
            "type": "text",
            "rowsMin": 10
        },
        "knowledgeBaseCategories": {
            "type": "linkMultiple",
            "tooltip": true
        },
        "calendarsToManage": {
            "type": "linkMultiple",
            "tooltip": true,
            "view": "chatwoot:views/account-user-membership/fields/calendars-to-manage",
            "columns": {
                "description": "calendarDescription",
                "eventType": "calendarEventType"
            },
            "additionalAttributeList": ["columns"]
        },
        "funnelsToManage": {
            "type": "linkMultiple",
            "view": "chatwoot:views/account-user-membership/fields/funnels-to-manage",
            "tooltip": "Funnels that this AI agent can create/manage opportunities in. Each funnel can have custom instructions for the AI.",
            "columns": {
                "description": "description"
            },
            "additionalAttributeList": ["columns"]
        },
        "chatwootTeams": {
            "type": "linkMultiple"
        },
        "syncStatus": {
            "type": "enum",
            "options": ["pending", "synced", "error"],
            "default": "pending"
        },
        "lastSyncedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "lastSyncError": {
            "type": "text",
            "readOnly": true
        },
        "chatwootAccountUserId": {
            "type": "int",
            "readOnly": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "required": true,
            "readOnly": true
        },
        "chatwootInboxes": {
            "type": "linkMultiple"
        },
        "calendarEventType": {
            "type": "enum",
            "options": ["Appointment", "Meeting", "Call"],
            "default": "Appointment",
            "readOnly": true,
            "tooltip": true
        }
    },
    "links": {
        "chatwootAccount": {
            "type": "belongsTo",
            "entity": "ChatwootAccount",
            "foreign": "accountUserMemberships"
        },
        "chatwootUser": {
            "type": "belongsTo",
            "entity": "ChatwootUser",
            "foreign": "accountUserMemberships"
        },
        "chatwootTeams": {
            "type": "hasMany",
            "entity": "ChatwootTeam",
            "relationName": "chatwootAccountUserMembershipChatwootTeam",
            "foreign": "accountUserMemberships"
        },
        "knowledgeBaseCategories": {
            "type": "hasMany",
            "entity": "KnowledgeBaseCategory",
            "relationName": "chatwootAccountUserMembershipKnowledgeBaseCategory",
            "foreign": "accountUserMemberships"
        },
        "calendarsToManage": {
            "type": "hasMany",
            "entity": "User",
            "relationName": "chatwootAccountUserMembershipCalendarUser",
            "foreign": "accountUserMembershipsWithCalendarAccess",
            "additionalColumns": {
                "description": {
                    "type": "text"
                },
                "eventType": {
                    "type": "varchar",
                    "len": 36,
                    "default": "Appointment"
                }
            },
            "columnAttributeMap": {
                "description": "description",
                "eventType": "eventType"
            }
        },
        "funnelsToManage": {
            "type": "hasMany",
            "entity": "Funnel",
            "relationName": "chatwootAccountUserMembershipFunnel",
            "foreign": "accountUserMembershipsWithFunnelAccess",
            "additionalColumns": {
                "description": {
                    "type": "text"
                }
            },
            "columnAttributeMap": {
                "description": "description"
            }
        },
        "wahaSessionLabels": {
            "type": "hasMany",
            "entity": "WahaSessionLabel",
            "foreign": "accountUserMembership"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "chatwootInboxes": {
            "type": "hasMany",
            "entity": "ChatwootInbox",
            "relationName": "chatwootAccountUserMembershipChatwootInbox",
            "foreign": "accountUserMemberships"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "uniqueMembership": {
            "unique": true,
            "columns": ["chatwootAccountId", "chatwootUserId", "deleteId"]
        },
        "chatwootAccountId": {
            "columns": ["chatwootAccountId"]
        },
        "chatwootUserId": {
            "columns": ["chatwootUserId"]
        },
        "createdAt": {
            "columns": ["createdAt"]
        },
        "createdAtId": {
            "unique": true,
            "columns": ["createdAt", "id"]
        }
    },
    "cascadeDelete": {
        "junctionTables": [
            {"table": "ChatwootAccountUserMembershipChatwootInbox", "column": "chatwootAccountUserMembershipId"},
            {"table": "ChatwootAccountUserMembershipChatwootTeam", "column": "chatwootAccountUserMembershipId"},
            {"table": "ChatwootAccountUserMembershipKnowledgeBaseCategory", "column": "chatwootAccountUserMembershipId"},
            {"table": "ChatwootAccountUserMembershipCalendarUser", "column": "chatwootAccountUserMembershipId"},
            {"table": "ChatwootAccountUserMembershipFunnel", "column": "chatwootAccountUserMembershipId"}
        ]
    }
}
