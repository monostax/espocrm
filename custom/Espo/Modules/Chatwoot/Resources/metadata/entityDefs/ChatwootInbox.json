{
    "deleteId": true,
    "fields": {
        "deleteId": {
            "type": "varchar",
            "maxLength": 17,
            "default": "0",
            "readOnly": true
        },
        "name": {
            "type": "varchar",
            "maxLength": 255,
            "required": true
        },
        "chatwootInboxId": {
            "type": "int",
            "required": true,
            "readOnly": true
        },
        "chatwootAccount": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true
        },
        "channelType": {
            "type": "foreign",
            "link": "chatwootInboxIntegration",
            "field": "channelType",
            "optionsReference": "ChatwootInboxIntegration.channelType",
            "view": "global:views/fields/svg-icon-enum",
            "svgIconByValue": {
                "whatsappQrcode": "whatsapp",
                "whatsappCloudApi": "whatsapp",
                "whatsappCoexistence": "whatsapp",
                "instagram": "instagram",
                "email": "mail",
                "Channel::Email": "mail",
                "Channel::WebWidget": "website",
                "web_widget": "website",
                "website": "website",
                "google": "google",
                "microsoft": "outlook",
                "outlook": "outlook"
            },
            "svgIconByContains": {
                "webwidget": "website",
                "web_widget": "website",
                "website": "website",
                "email": "mail",
                "gmail": "google",
                "google": "google",
                "outlook": "outlook",
                "microsoft": "outlook"
            },
            "readOnly": true
        },
        "websiteUrl": {
            "type": "url"
        },
        "phoneNumber": {
            "type": "varchar",
            "maxLength": 50
        },
        "provider": {
            "type": "varchar",
            "maxLength": 100
        },
        "medium": {
            "type": "varchar",
            "maxLength": 100
        },
        "greetingEnabled": {
            "type": "bool",
            "default": false
        },
        "greetingMessage": {
            "type": "text"
        },
        "avatarUrl": {
            "type": "text"
        },
        "inboxIdentifier": {
            "type": "varchar",
            "maxLength": 255,
            "tooltip": true
        },
        "lastSyncedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "required": true,
            "readOnly": true
        },
        "chatwootInboxIntegration": {
            "type": "link"
        },
        "remoteChannelType": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "tooltip": true
        },
        "inboundEmail": {
            "type": "link",
            "readOnly": true,
            "tooltip": true
        },
        "emailAccount": {
            "type": "link",
            "readOnly": true,
            "tooltip": true
        },
        "emailFetchOwner": {
            "type": "enum",
            "options": ["", "chatwoot", "crm"],
            "default": "",
            "readOnly": true,
            "tooltip": true
        },
        "emailOAuthAccount": {
            "type": "link",
            "readOnly": true,
            "tooltip": true
        },
        "autoPendingEnabled": {
            "type": "foreign",
            "link": "chatwootInboxIntegration",
            "field": "autoPendingEnabled",
            "readOnly": true
        },
        "status": {
            "type": "foreign",
            "link": "chatwootInboxIntegration",
            "field": "status",
            "view": "chatwoot:views/chatwoot-inbox/fields/status",
            "style": {
                "DRAFT": "default",
                "CREATING": "info",
                "PENDING_QR": "warning",
                "CONNECTING": "info",
                "ACTIVE": "success",
                "DISCONNECTED": "danger",
                "FAILED": "danger",
                "PENDING_COEXISTENCE_CONFIRMATION": "warning",
                "PENDING_WAHA_LINK": "warning"
            },
            "readOnly": true
        },
        "accountUserMemberships": {
            "type": "linkMultiple"
        },
        "chatwootTeams": {
            "type": "linkMultiple",
            "tooltip": true
        }
    },
    "links": {
        "chatwootAccount": {
            "type": "belongsTo",
            "entity": "ChatwootAccount",
            "foreign": "inboxes"
        },
        "contactInboxes": {
            "type": "hasMany",
            "entity": "ChatwootContactInbox",
            "foreign": "inbox"
        },
        "conversations": {
            "type": "hasMany",
            "entity": "ChatwootConversation",
            "foreign": "inbox"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "chatwootInboxIntegration": {
            "type": "belongsTo",
            "entity": "ChatwootInboxIntegration",
            "foreign": "chatwootInbox"
        },
        "inboundEmail": {
            "type": "belongsTo",
            "entity": "InboundEmail",
            "foreign": "chatwootInbox"
        },
        "emailAccount": {
            "type": "belongsTo",
            "entity": "EmailAccount",
            "foreign": "chatwootInbox"
        },
        "emailOAuthAccount": {
            "type": "hasOne",
            "entity": "OAuthAccount",
            "foreign": "chatwootEmailInbox"
        },
        "accountUserMemberships": {
            "type": "hasMany",
            "entity": "ChatwootAccountUserMembership",
            "relationName": "chatwootAccountUserMembershipChatwootInbox",
            "foreign": "chatwootInboxes"
        },
        "chatwootTeams": {
            "type": "hasMany",
            "entity": "ChatwootTeam",
            "relationName": "chatwootInboxChatwootTeam",
            "foreign": "chatwootInboxes"
        },
        "whatsAppCampaigns": {
            "type": "hasMany",
            "entity": "WhatsAppCampaign",
            "foreign": "chatwootInbox"
        }
    },
    "indexes": {
        "uniqueInbox": {
            "unique": true,
            "columns": [
                "chatwootInboxId",
                "chatwootAccountId",
                "deleteId"
            ]
        },
        "chatwootAccountId": {
            "columns": [
                "chatwootAccountId"
            ]
        }
    },
    "cascadeDelete": {
        "links": [
            "conversations",
            "contactInboxes"
        ],
        "junctionTables": [
            {
                "table": "ChatwootAccountUserMembershipChatwootInbox",
                "column": "chatwootInboxId"
            },
            {
                "table": "ChatwootInboxChatwootTeam",
                "column": "chatwootInboxId"
            }
        ]
    }
}
