{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 255
        },
        "platform": {
            "type": "link",
            "required": true
        },
        "chatwootAccountId": {
            "type": "int",
            "readOnly": true,
            "tooltip": true
        },
        "apiKey": {
            "type": "password",
            "tooltip": true,
            "required": false
        },
        "conciergeUser": {
            "type": "link",
            "readOnly": true
        },
        "locale": {
            "type": "enum",
            "options": ["pt_BR", "en", "es", "fr", "de", "it"],
            "default": "pt_BR"
        },
        "domain": {
            "type": "varchar",
            "maxLength": 255
        },
        "supportEmail": {
            "type": "email"
        },
        "status": {
            "type": "enum",
            "options": ["active", "suspended"],
            "default": "active"
        },
        "contactSyncEnabled": {
            "type": "bool",
            "default": true,
            "tooltip": true
        },
        "contactPushEnabled": {
            "type": "bool",
            "default": true,
            "tooltip": true
        },
        "lastContactSyncAt": {
            "type": "datetime",
            "readOnly": true,
            "tooltip": true
        },
        "lastConversationSyncAt": {
            "type": "datetime",
            "readOnly": true,
            "tooltip": true
        },
        "contactSyncCursor": {
            "type": "int",
            "readOnly": true,
            "tooltip": true
        },
        "conversationSyncCursor": {
            "type": "int",
            "readOnly": true,
            "tooltip": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "required": true
        },
        "tenant": {
            "type": "link",
            "view": "views/fields/link",
            "tooltip": true
        }
    },
    "links": {
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "chatwootAccounts"
        },
        "platform": {
            "type": "belongsTo",
            "entity": "ChatwootPlatform",
            "foreign": "accounts"
        },
        "conciergeUser": {
            "type": "belongsTo",
            "entity": "ChatwootUser",
            "foreign": "conciergeForAccount"
        },
        "chatwootTeams": {
            "type": "hasMany",
            "entity": "ChatwootTeam",
            "foreign": "account"
        },
        "contacts": {
            "type": "hasMany",
            "entity": "ChatwootContact",
            "foreign": "chatwootAccount"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "syncStates": {
            "type": "hasMany",
            "entity": "ChatwootSyncState",
            "foreign": "chatwootAccount"
        },
        "inboxes": {
            "type": "hasMany",
            "entity": "ChatwootInbox",
            "foreign": "chatwootAccount"
        },

        "chatwootInboxIntegrations": {
            "type": "hasMany",
            "entity": "ChatwootInboxIntegration",
            "foreign": "chatwootAccount"
        },
        "conversations": {
            "type": "hasMany",
            "entity": "ChatwootConversation",
            "foreign": "chatwootAccount"
        },
        "labels": {
            "type": "hasMany",
            "entity": "ChatwootLabel",
            "foreign": "chatwootAccount"
        },
        "accountUserMemberships": {
            "type": "hasMany",
            "entity": "ChatwootAccountUserMembership",
            "foreign": "chatwootAccount"
        },
        "whatsAppCampaigns": {
            "type": "hasMany",
            "entity": "WhatsAppCampaign",
            "foreign": "chatwootAccount",
            "layoutRelationshipsDisabled": true
        },
        "whatsAppCampaignContacts": {
            "type": "hasMany",
            "entity": "WhatsAppCampaignContact",
            "foreign": "chatwootAccount",
            "layoutRelationshipsDisabled": true
        },
        "webhooks": {
            "type": "hasMany",
            "entity": "ChatwootAccountWebhook",
            "foreign": "account"
        },
        "contactChannelIdentities": {
            "type": "hasMany",
            "entity": "ContactChannelIdentity",
            "foreign": "chatwootAccount"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": ["name", "deleted"]
        },
        "assignedUser": {
            "columns": ["deleted"]
        },
        "createdAt": {
            "columns": ["createdAt"]
        },
        "createdAtId": {
            "unique": true,
            "columns": ["createdAt", "id"]
        },
        "tenantId": {
            "columns": ["tenantId", "deleted"]
        }
    },
    "cascadeDelete": {
        "links": [
            "chatwootInboxIntegrations",
            "inboxes",
            "contacts",

            "chatwootTeams",
            "syncStates",
            "conversations",
            "labels",
            "accountUserMemberships",
            "webhooks"
        ]
    }
}

