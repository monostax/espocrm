{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 255,
            "link": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Draft",
                "Active",
                "Paused",
                "Completed",
                "Cancelled"
            ],
            "default": "Draft",
            "style": {
                "Draft": null,
                "Active": "primary",
                "Paused": "warning",
                "Completed": "success",
                "Cancelled": "danger"
            }
        },
        "chatwootInbox": {
            "type": "link",
            "required": true
        },
        "chatwootAccount": {
            "type": "link",
            "required": true
        },
        "dialerCampaignId": {
            "type": "int",
            "readOnly": true,
            "tooltip": true
        },
        "maxAttempts": {
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 10,
            "tooltip": true
        },
        "retryDelayMinutes": {
            "type": "int",
            "default": 60,
            "min": 5,
            "tooltip": true
        },
        "createOpportunity": {
            "type": "bool",
            "default": false,
            "tooltip": true
        },
        "attributionDispositions": {
            "type": "multiEnum",
            "options": [
                "connected_interested",
                "connected_not_interested",
                "callback",
                "voicemail",
                "no_answer",
                "busy",
                "wrong_number",
                "dnc",
                "skipped"
            ],
            "default": [
                "connected_interested"
            ],
            "tooltip": true
        },
        "funnel": {
            "type": "link"
        },
        "opportunityStage": {
            "type": "link"
        },
        "opportunityAssignedUser": {
            "type": "link"
        },
        "targetLists": {
            "type": "linkMultiple"
        },
        "manualContacts": {
            "type": "linkMultiple"
        },
        "excludeCampaigns": {
            "type": "linkMultiple",
            "layoutRelationshipsDisabled": false
        },
        "excludingTargetLists": {
            "type": "linkMultiple"
        },
        "campaignContacts": {
            "type": "linkMultiple",
            "readOnly": true
        },
        "opportunities": {
            "type": "linkMultiple",
            "readOnly": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "chatwootInbox": {
            "type": "belongsTo",
            "entity": "ChatwootInbox",
            "foreign": "callCampaigns"
        },
        "chatwootAccount": {
            "type": "belongsTo",
            "entity": "ChatwootAccount",
            "foreign": "callCampaigns"
        },
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "callCampaigns"
        },
        "targetLists": {
            "type": "hasMany",
            "entity": "TargetList",
            "foreign": "callCampaigns",
            "relationName": "callCampaignTargetList"
        },
        "manualContacts": {
            "type": "hasMany",
            "entity": "Contact",
            "foreign": "callCampaignsManual",
            "relationName": "callCampaignManualContact"
        },
        "excludeCampaigns": {
            "type": "hasMany",
            "entity": "CallCampaign",
            "foreign": "excludedByCampaigns",
            "relationName": "callCampaignExcludeCampaign",
            "midKeys": [
                "callCampaignId",
                "excludeCallCampaignId"
            ]
        },
        "excludedByCampaigns": {
            "type": "hasMany",
            "entity": "CallCampaign",
            "foreign": "excludeCampaigns",
            "relationName": "callCampaignExcludeCampaign",
            "midKeys": [
                "excludeCallCampaignId",
                "callCampaignId"
            ],
            "layoutRelationshipsDisabled": true
        },
        "excludingTargetLists": {
            "type": "hasMany",
            "entity": "TargetList",
            "foreign": "callCampaignsExcluding",
            "relationName": "callCampaignTargetListExcluding"
        },
        "campaignContacts": {
            "type": "hasMany",
            "entity": "CallCampaignContact",
            "foreign": "callCampaign"
        },
        "funnel": {
            "type": "belongsTo",
            "entity": "Funnel",
            "foreign": "callCampaigns"
        },
        "opportunityStage": {
            "type": "belongsTo",
            "entity": "OpportunityStage",
            "foreign": "callCampaigns"
        },
        "opportunityAssignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "opportunities": {
            "type": "hasMany",
            "entity": "Opportunity",
            "foreign": "callCampaigns",
            "relationName": "callCampaignOpportunity"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    }
}
