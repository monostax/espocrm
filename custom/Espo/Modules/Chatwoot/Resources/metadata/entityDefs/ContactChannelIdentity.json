{
    "deleteId": true,
    "fields": {
        "deleteId": {
            "type": "varchar",
            "maxLength": 17,
            "default": "0",
            "readOnly": true
        },
        "name": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "channelType": {
            "type": "enum",
            "required": true,
            "options": [
                "whatsapp",
                "instagram",
                "telegram",
                "facebook",
                "twitter",
                "sms",
                "email",
                "web_widget",
                "api",
                "line",
                "viber",
                "other"
            ]
        },
        "sourceId": {
            "type": "varchar",
            "required": true,
            "maxLength": 255,
            "tooltip": "Routable channel-specific identifier (E.164 phone for whatsapp/sms, page-scoped user id for instagram/facebook, chat id for telegram, lowercased email for email). For manually entered social identities whose scoped id is not yet known, this temporarily holds the handle until the first inbound message rotates it to the scoped id."
        },
        "handle": {
            "type": "varchar",
            "maxLength": 255,
            "tooltip": "Human-readable username/handle (e.g. Instagram username, @-stripped, lowercased). Never routable — kept alongside the scoped-id sourceId so handle-keyed and scoped-id-keyed observations merge into one identity."
        },
        "whatsappLid": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "tooltip": "WhatsApp LID (privacy identifier, e.g. 272628082307301@lid) observed for this WhatsApp identity. Kept alongside the E.164 sourceId so LID-keyed chats reconcile to the same identity."
        },
        "label": {
            "type": "varchar",
            "maxLength": 255,
            "tooltip": "Optional human-readable label (e.g. Instagram username)"
        },
        "isPrimary": {
            "type": "bool",
            "default": false
        },
        "contact": {
            "type": "link",
            "required": true
        },
        "tenant": {
            "type": "link",
            "required": true
        },
        "chatwootAccount": {
            "type": "link",
            "readOnly": true,
            "tooltip": "Originating Chatwoot account where this identity was first observed"
        },
        "chatwootInbox": {
            "type": "link",
            "readOnly": true,
            "tooltip": "Originating Chatwoot inbox (if applicable)"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "tooltip": "Mirrored from the parent Contact's teams for team-scoped ACL. Kept in sync automatically."
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "contact": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "channelIdentities"
        },
        "tenant": {
            "type": "belongsTo",
            "entity": "Tenant",
            "foreign": "contactChannelIdentities"
        },
        "chatwootAccount": {
            "type": "belongsTo",
            "entity": "ChatwootAccount",
            "foreign": "contactChannelIdentities"
        },
        "chatwootInbox": {
            "type": "belongsTo",
            "entity": "ChatwootInbox"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "chatwootConversations": {
            "type": "hasMany",
            "entity": "ChatwootConversation",
            "foreign": "channelIdentity"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "uniqueTenantChannelSource": {
            "unique": true,
            "columns": ["tenantId", "channelType", "sourceId", "deleteId"]
        },
        "contactId": {
            "columns": ["contactId"]
        },
        "channelSource": {
            "columns": ["channelType", "sourceId", "deleteId"]
        },
        "tenantWhatsappLid": {
            "columns": ["tenantId", "whatsappLid", "deleteId"]
        },
        "tenantChannelHandle": {
            "columns": ["tenantId", "channelType", "handle"]
        },
        "createdAt": {
            "columns": ["createdAt"]
        }
    }
}
