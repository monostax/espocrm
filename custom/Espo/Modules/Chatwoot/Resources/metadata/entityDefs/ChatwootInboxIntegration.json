{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 255
        },
        "phoneNumber": {
            "type": "varchar",
            "maxLength": 50,
            "tooltip": true,
            "view": "chatwoot:views/chatwoot-inbox-integration/fields/phone-number"
        },
        "phoneNumberId": {
            "type": "varchar",
            "maxLength": 64,
            "readOnlyAfterCreate": true,
            "tooltip": true
        },
        "status": {
            "type": "enum",
            "options": [
                "DRAFT",
                "CREATING",
                "PENDING_QR",
                "PENDING_COEXISTENCE_CONFIRMATION",
                "PENDING_WAHA_LINK",
                "CONNECTING",
                "ACTIVE",
                "DISCONNECTED",
                "FAILED"
            ],
            "default": "DRAFT",
            "view": "views/fields/enum-styled",
            "style": {
                "DRAFT": "default",
                "CREATING": "info",
                "PENDING_QR": "warning",
                "PENDING_COEXISTENCE_CONFIRMATION": "warning",
                "PENDING_WAHA_LINK": "warning",
                "CONNECTING": "info",
                "ACTIVE": "success",
                "DISCONNECTED": "danger",
                "FAILED": "danger"
            },
            "readOnly": true
        },
        "channelType": {
            "type": "enum",
            "options": ["whatsappQrcode", "whatsappCloudApi", "whatsappCoexistence", "instagram", "email"],
            "default": "whatsappQrcode",
            "view": "global:views/fields/svg-icon-enum",
            "svgIconByValue": {
                "whatsappQrcode": "whatsapp",
                "whatsappCloudApi": "whatsapp",
                "whatsappCoexistence": "whatsapp",
                "instagram": "instagram",
                "email": "mail",
                "google": "google",
                "microsoft": "outlook",
                "outlook": "outlook",
                "website": "website",
                "Channel::WebWidget": "website",
                "web_widget": "website"
            },
            "svgIconByContains": {
                "webwidget": "website",
                "web_widget": "website",
                "website": "website",
                "email": "mail",
                "gmail": "google",
                "google": "google",
                "outlook": "outlook",
                "microsoft": "outlook"
            },
            "readOnlyAfterCreate": true
        },
        "inboundEmail": {
            "type": "link",
            "tooltip": true
        },
        "emailAccount": {
            "type": "link",
            "tooltip": true
        },
        "wahaPlatform": {
            "type": "link",
            "readOnly": true,
            "utility": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true
        },
        "chatwootAccount": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true
        },
        "credential": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "tooltip": true
        },
        "oAuthAccount": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "tooltip": true
        },
        "businessAccountId": {
            "type": "varchar",
            "maxLength": 64,
            "readOnlyAfterCreate": true,
            "tooltip": true,
            "view": "chatwoot:views/chatwoot-inbox-integration/fields/business-account"
        },
        "businessAccountName": {
            "type": "varchar",
            "maxLength": 255,
            "readOnlyAfterCreate": true
        },
        "wahaSessionName": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true,
            "tooltip": true
        },
        "wahaSessionId": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true,
            "notStorable": true
        },
        "wahaAppId": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "wahaChatwootInboxId": {
            "type": "int",
            "readOnly": true,
            "utility": true,
            "layoutMassUpdateDisabled": true,
            "tooltip": true
        },
        "wahaWebhookSecret": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "utility": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true
        },
        "chatwootInboxIdentifier": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "chatwootInbox": {
            "type": "link",
            "readOnly": true
        },
        "chatwootInboxRecordId": {
            "type": "varchar",
            "notStorable": true,
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutEditDisabled": true
        },
        "whatsappId": {
            "type": "varchar",
            "maxLength": 50,
            "readOnly": true,
            "tooltip": true
        },
        "whatsappName": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "instagramId": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "tooltip": true
        },
        "instagramUsername": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true
        },
        "tokenExpiresAt": {
            "type": "datetime",
            "readOnly": true
        },
        "instagramBusinessAccountId": {
            "type": "varchar",
            "notStorable": true,
            "utility": true,
            "layoutListDisabled": true,
            "maxLength": 64,
            "view": "chatwoot:views/chatwoot-inbox-integration/fields/instagram-business-account"
        },
        "errorMessage": {
            "type": "text",
            "readOnly": true
        },
        "connectedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "lastActivityAt": {
            "type": "datetime",
            "readOnly": true
        },
        "qrCode": {
            "type": "text",
            "notStorable": true,
            "readOnly": true,
            "layoutDetailDisabled": false,
            "layoutListDisabled": true,
            "layoutEditDisabled": true,
            "view": "chatwoot:views/chatwoot-inbox-integration/fields/qr-code"
        },
        "wahaIgnoreStatus": {
            "type": "bool",
            "default": true,
            "tooltip": true
        },
        "wahaIgnoreGroups": {
            "type": "bool",
            "default": false,
            "tooltip": true
        },
        "wahaIgnoreChannels": {
            "type": "bool",
            "default": true,
            "tooltip": true
        },
        "wahaIgnoreBroadcast": {
            "type": "bool",
            "default": true,
            "tooltip": true
        },
        "autoPendingEnabled": {
            "type": "bool",
            "default": false,
            "tooltip": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "readOnly": true
        },
        "chatwootTeams": {
            "type": "linkMultiple",
            "tooltip": true
        }
    },
    "links": {
        "wahaPlatform": {
            "type": "belongsTo",
            "entity": "WahaPlatform",
            "foreign": "chatwootInboxIntegrations"
        },
        "chatwootAccount": {
            "type": "belongsTo",
            "entity": "ChatwootAccount",
            "foreign": "chatwootInboxIntegrations"
        },
        "credential": {
            "type": "belongsTo",
            "entity": "Credential"
        },
        "oAuthAccount": {
            "type": "belongsTo",
            "entity": "OAuthAccount"
        },
        "inboundEmail": {
            "type": "belongsTo",
            "entity": "InboundEmail",
            "foreign": "chatwootInboxIntegrations"
        },
        "emailAccount": {
            "type": "belongsTo",
            "entity": "EmailAccount",
            "foreign": "chatwootInboxIntegrations"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "chatwootInbox": {
            "type": "hasOne",
            "entity": "ChatwootInbox",
            "foreign": "chatwootInboxIntegration"
        },
        "chatwootTeams": {
            "type": "hasMany",
            "entity": "ChatwootTeam",
            "relationName": "chatwootInboxIntegrationChatwootTeam",
            "foreign": "chatwootInboxIntegrations"
        },
        "wahaSessionLabels": {
            "type": "hasMany",
            "entity": "WahaSessionLabel",
            "foreign": "inboxIntegration"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": ["name", "deleted"]
        },
        "status": {
            "columns": ["status", "deleted"]
        },
        "createdAt": {
            "columns": ["createdAt"]
        },
        "createdAtId": {
            "unique": true,
            "columns": ["createdAt", "id"]
        }
    },
    "cascadeDelete": {
        "links": ["chatwootInbox", "wahaSessionLabels"]
    }
}
