{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 255
        },
        "displayName": {
            "type": "varchar",
            "maxLength": 255
        },
        "email": {
            "type": "email",
            "required": true
        },
        "password": {
            "type": "password",
            "dbType": "text",
            "required": true,
            "tooltip": true
        },
        "platform": {
            "type": "link",
            "required": true
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user",
            "tooltip": true
        },
        "chatwootUserId": {
            "type": "int",
            "readOnly": true,
            "tooltip": true
        },
        "userAccessToken": {
            "type": "password",
            "dbType": "text",
            "readOnly": true,
            "tooltip": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "textFilterDisabled": true,
            "exportDisabled": true,
            "importDisabled": true
        },
        "crmAvatarSyncHash": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "textFilterDisabled": true,
            "exportDisabled": true,
            "importDisabled": true
        },
        "chatwootAvatarSyncHash": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true,
            "layoutFiltersDisabled": true,
            "textFilterDisabled": true,
            "exportDisabled": true,
            "importDisabled": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "required": true
        }
    },
    "links": {
        "platform": {
            "type": "belongsTo",
            "entity": "ChatwootPlatform",
            "foreign": "users"
        },
        "conciergeForAccount": {
            "type": "hasOne",
            "entity": "ChatwootAccount",
            "foreign": "conciergeUser"
        },

        "accountUserMemberships": {
            "type": "hasMany",
            "entity": "ChatwootAccountUserMembership",
            "foreign": "chatwootUser"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "cascadeDelete": {
        "links": ["accountUserMemberships"]
    },
    "indexes": {
        "name": {
            "columns": ["name", "deleted"]
        },
        "assignedUser": {
            "columns": ["assignedUserId", "deleted"]
        },
        "platformId": {
            "columns": ["platformId", "deleted"]
        },
        "chatwootUserIdPlatformId": {
            "columns": ["chatwootUserId", "platformId", "deleted"]
        },
        "createdAt": {
            "columns": ["createdAt"]
        },
        "createdAtId": {
            "unique": true,
            "columns": ["createdAt", "id"]
        }
    }
}
