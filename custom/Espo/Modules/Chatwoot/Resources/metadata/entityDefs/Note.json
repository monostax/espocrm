{
    "transactionalSave": true,
    "fields": {
        "opportunityThreadRoot": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "utility": true,
            "customizationDisabled": true
        },
        "opportunityThreadSummary": {
            "type": "jsonObject",
            "notStorable": true,
            "readOnly": true,
            "utility": true
        },
        "opportunityPostDeleted": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "utility": true
        },
        "type": {
            "options": ["__APPEND__", "ChatwootMessageReceived", "ActivityOverdue"]
        },
        "opportunityStreamEventKey": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "utility": true
        },
        "opportunityChatwootAccountId": {
            "type": "int",
