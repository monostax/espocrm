            "readOnlyAfterCreate": true,
            "utility": true
        },
        "opportunityMentionUserIds": {
            "type": "jsonArray",
            "readOnly": true,
            "utility": true
        },
        "opportunityCanEdit": {
            "type": "bool",
            "notStorable": true,
            "readOnly": true,
            "customizationDisabled": true,
            "utility": true
        },
        "opportunityCanDelete": {
            "type": "bool",
            "notStorable": true,
            "readOnly": true,
            "customizationDisabled": true,
            "utility": true
        }
    },
    "links": {
        "opportunityThreadRoot": {
            "type": "belongsTo",
            "entity": "Note",
            "noForeignName": true
        }
    },
    "indexes": {
        "opportunityThread": {
