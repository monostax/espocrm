{
    "fields": {
        "operation": { "type": "link", "required": true },
        "opportunityId": { "type": "varchar", "maxLength": 64, "required": true },
        "status": { "type": "enum", "options": ["Pending", "Succeeded", "Failed"], "default": "Pending" },
        "noteId": { "type": "varchar", "maxLength": 64 },
        "error": { "type": "varchar", "maxLength": 32 },
