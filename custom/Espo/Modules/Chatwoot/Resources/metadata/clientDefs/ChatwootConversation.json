{
    "controller": "controllers/record",
    "iconClass": "ti ti-messages",
    "createDisabled": true,
    "kanbanViewMode": false,
    "views": {
        "list": "chatwoot:views/chatwoot-conversation/list"
    },
    "listViewModeList": ["list"],
    "listDefaultViewMode": "list",
    "filterList": [
        {
            "name": "open",
            "style": "warning"
        },
        {
            "name": "pending",
            "style": "info"
        },
        {
            "name": "resolved",
            "style": "success"
        },
        "snoozed",
        {
            "name": "instagram",
            "style": "info"
        }
    ],
    "boolFilterList": ["assignedToMe"],
    "modalViews": {
        "detail": "views/modals/detail"
    },
    "recordViews": {
        "list": "chatwoot:views/chatwoot-conversation/record/list",
