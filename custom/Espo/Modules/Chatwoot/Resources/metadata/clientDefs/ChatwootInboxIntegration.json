{
    "controller": "controllers/record",
    "iconClass": "ti ti-plug-connected",
    "duplicateDisabled": true,
    "removeDisabled": true,
    "mergeDisabled": true,
    "deleteDisabled": true,
    "createDisabled": false,
    "recordViews": {
        "edit": "chatwoot:views/chatwoot-inbox-integration/record/edit"
    },
    "modelDefaultsPreparator": "chatwoot:handlers/chatwoot-inbox-integration/defaults-preparator",
    "modalViews": {
        "edit": "chatwoot:views/chatwoot-inbox-integration/modals/edit"
    },
    "defaultSidePanelFieldList": ["chatwootAccount", "chatwootInbox", "teams"],
    "dynamicLogic": {
        "fields": {
            "status": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isNotEmpty",
                            "attribute": "id"
                        }
                    ]
                }
            },
            "whatsappName": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isNotEmpty",
                            "attribute": "id"
                        }
                    ]
                }
            },
            "team": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isNotEmpty",
                            "attribute": "id"
                        }
                    ]
                }
            },
            "chatwootInbox": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isNotEmpty",
                            "attribute": "id"
                        }
                    ]
                }
            },
            "oAuthAccount": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCloudApi"
                                },
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCoexistence"
                                },
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "instagram"
                                }
                            ]
                        }
                    ]
                },
                "required": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCloudApi"
                                },
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCoexistence"
                                },
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "instagram"
                                }
                            ]
                        }
                    ]
                }
            },
            "businessAccountId": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCloudApi"
                                },
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCoexistence"
                                }
                            ]
                        },
                        {
                            "type": "isNotEmpty",
                            "attribute": "oAuthAccountId"
                        }
                    ]
                },
                "required": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "whatsappCloudApi"
                        }
                    ]
                }
            },
            "phoneNumber": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCloudApi"
                                },
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCoexistence"
                                }
                            ]
                        }
                    ]
                },
                "required": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "whatsappCloudApi"
                        }
                    ]
                }
            },
            "phoneNumberId": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCloudApi"
                                },
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCoexistence"
                                }
                            ]
                        },
                        {
                            "type": "isNotEmpty",
                            "attribute": "id"
                        }
                    ]
                }
            },
            "qrCode": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappQrcode"
                                },
                                {
                                    "type": "and",
                                    "value": [
                                        {
                                            "type": "equals",
                                            "attribute": "channelType",
                                            "value": "whatsappCoexistence"
                                        },
                                        {
                                            "type": "equals",
                                            "attribute": "status",
                                            "value": "PENDING_WAHA_LINK"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            },
            "wahaIgnoreStatus": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "whatsappQrcode"
                        }
                    ]
                }
            },
            "wahaIgnoreGroups": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "whatsappQrcode"
                        }
                    ]
                }
            },
            "wahaIgnoreChannels": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "whatsappQrcode"
                        }
                    ]
                }
            },
            "wahaIgnoreBroadcast": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "whatsappQrcode"
                        }
                    ]
                }
            },
            "instagramBusinessAccountId": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "instagram"
                        },
                        {
                            "type": "isNotEmpty",
                            "attribute": "oAuthAccountId"
                        }
                    ]
                },
                "required": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "instagram"
                        }
                    ]
                }
            },
            "instagramId": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "instagram"
                        },
                        {
                            "type": "isNotEmpty",
                            "attribute": "id"
                        }
                    ]
                }
            },
            "instagramUsername": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "instagram"
                        },
                        {
                            "type": "isNotEmpty",
                            "attribute": "id"
                        }
                    ]
                }
            },
            "tokenExpiresAt": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "instagram"
                        },
                        {
                            "type": "isNotEmpty",
                            "attribute": "id"
                        }
                    ]
                }
            }
        }
    },
    "viewSetupHandlers": {
        "record/detail": [
            "chatwoot:handlers/chatwoot-inbox-integration/record-detail-setup"
        ],
        "record/edit": [
            "chatwoot:handlers/chatwoot-inbox-integration/record-detail-setup"
        ]
    },
    "detailActionList": [
        {
            "name": "activate",
            "label": "Activate",
            "handler": "chatwoot:handlers/chatwoot-inbox-integration/detail-actions",
            "actionFunction": "activate",
            "checkVisibilityFunction": "isActivateAvailable",
            "groupIndex": 0
        },
        {
            "name": "repair",
            "label": "Repair",
            "handler": "chatwoot:handlers/chatwoot-inbox-integration/detail-actions",
            "actionFunction": "repair",
            "checkVisibilityFunction": "isRepairAvailable",
            "groupIndex": 0
        },
        {
            "name": "disconnect",
            "label": "Disconnect",
            "handler": "chatwoot:handlers/chatwoot-inbox-integration/detail-actions",
            "actionFunction": "disconnect",
            "checkVisibilityFunction": "isDisconnectAvailable",
            "groupIndex": 1
        },
        {
            "name": "reconnect",
            "label": "Reconnect",
            "handler": "chatwoot:handlers/chatwoot-inbox-integration/detail-actions",
            "actionFunction": "reconnect",
            "checkVisibilityFunction": "isReconnectAvailable",
            "groupIndex": 1
        },
        {
            "name": "linkWahaCompanion",
            "label": "Link WhatsApp Companion",
            "handler": "chatwoot:handlers/chatwoot-inbox-integration/detail-actions",
            "actionFunction": "linkWahaCompanion",
            "checkVisibilityFunction": "isLinkWahaCompanionAvailable",
            "groupIndex": 1
        }
    ],
    "bottomPanels": {
        "detail": []
    }
}
