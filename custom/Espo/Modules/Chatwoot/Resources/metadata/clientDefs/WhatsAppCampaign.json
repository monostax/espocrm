{
    "controller": "controllers/record",
    "iconClass": "ti ti-send",
    "dynamicLogic": {
        "fields": {
            "templateName": {
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "notEquals",
                            "attribute": "status",
                            "value": "Draft"
                        }
                    ]
                }
            },
            "chatwootInbox": {
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "notEquals",
                            "attribute": "status",
                            "value": "Draft"
                        }
                    ]
                }
            },
            "targetLists": {
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "notEquals",
                            "attribute": "status",
                            "value": "Draft"
                        },
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "notEquals",
                                    "attribute": "status",
                                    "value": "Sending"
                                },
                                {
                                    "type": "isFalse",
                                    "attribute": "continuousEnrollment"
                                }
                            ]
                        }
                    ]
                }
            },
            "manualContacts": {
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "notEquals",
                            "attribute": "status",
                            "value": "Draft"
                        },
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "notEquals",
                                    "attribute": "status",
                                    "value": "Sending"
                                },
                                {
                                    "type": "isFalse",
                                    "attribute": "continuousEnrollment"
                                }
                            ]
                        }
                    ]
                }
            },
            "continuousEnrollment": {
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "notEquals",
                            "attribute": "status",
                            "value": "Draft"
                        }
                    ]
                }
            },
            "excludeCampaigns": {
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "notEquals",
                            "attribute": "status",
                            "value": "Draft"
                        }
                    ]
                }
            },
            "excludingTargetLists": {
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "notEquals",
                            "attribute": "status",
                            "value": "Draft"
                        }
                    ]
                }
            },
            "parameterMapping": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isNotEmpty",
                            "attribute": "parameterMapping"
                        }
                    ]
                },
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "notEquals",
                            "attribute": "status",
                            "value": "Draft"
                        }
                    ]
                }
            }
        },
        "panels": {
            "exclusions": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "status",
                            "value": "Draft"
                        }
                    ]
                }
            },
            "statistics": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "notEquals",
                            "attribute": "status",
                            "value": "Draft"
                        }
                    ]
                }
            }
        }
    },
    "bottomPanels": {
        "detail": [
            {
                "name": "campaignContacts",
                "label": "Recipients",
                "view": "views/record/panels/relationship",
                "link": "campaignContacts",
                "select": false,
                "create": false,
                "rowActionsView": false,
                "layout": "listSmall",
                "order": 10
            }
        ]
    },
    "detailActionList": [
        {
            "name": "sendCampaign",
            "label": "Send Campaign",
            "handler": "chatwoot:handlers/whatsapp-campaign/detail-actions",
            "actionFunction": "sendCampaign",
            "checkVisibilityFunction": "isSendAvailable",
            "groupIndex": 0
        },
        {
            "name": "createAbTest",
            "label": "Create A/B Test",
            "handler": "chatwoot:handlers/whatsapp-campaign/detail-actions",
            "actionFunction": "createAbTest",
            "checkVisibilityFunction": "isCreateAbTestAvailable",
            "groupIndex": 0
        },
        {
            "name": "abortCampaign",
            "label": "Abort Campaign",
            "handler": "chatwoot:handlers/whatsapp-campaign/detail-actions",
            "actionFunction": "abortCampaign",
            "checkVisibilityFunction": "isAbortAvailable",
            "groupIndex": 1
        },
        {
            "name": "stopEnrollment",
            "label": "Stop Enrollment",
            "handler": "chatwoot:handlers/whatsapp-campaign/detail-actions",
            "actionFunction": "stopEnrollment",
            "checkVisibilityFunction": "isStopEnrollmentAvailable",
            "groupIndex": 1
        }
    ]
}

