    {
        "label": "WhatsApp Connection",
        "name": "whatsappConnection",
        "dynamicLogicVisible": {
            "conditionGroup": [
                {
                    "type": "isNotEmpty",
                    "attribute": "id"
                },
                {
                    "type": "or",
                    "value": [
                        {
                            "type": "equals",
                            "attribute": "channelType",
                            "value": "whatsappQrcode"
                        },
                        {
                            "type": "and",
                            "value": [
                                {
                                    "type": "equals",
                                    "attribute": "channelType",
                                    "value": "whatsappCoexistence"
                                },
                                {
                                    "type": "equals",
                                    "attribute": "status",
                                    "value": "PENDING_WAHA_LINK"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "rows": [
            [
                {
                    "name": "qrCode",
                    "fullWidth": true
                }
            ]
        ]
    },
    {
        "label": "Ignore Rules",
        "name": "ignoreRules",
        "dynamicLogicVisible": {
            "conditionGroup": [
                {
                    "type": "isNotEmpty",
                    "attribute": "id"
                },
                {
                    "type": "equals",
                    "attribute": "channelType",
                    "value": "whatsappQrcode"
                }
            ]
        },
        "rows": [
            [
                {
                    "name": "wahaIgnoreStatus"
                },
                {
                    "name": "wahaIgnoreGroups"
                }
            ],
            [
                {
                    "name": "wahaIgnoreChannels"
                },
                {
                    "name": "wahaIgnoreBroadcast"
                }
            ],
            [
                {
                    "name": "autoPendingEnabled"
                },
                false
            ]
        ]
    },
    {
        "label": "Error",
        "name": "error",
        "dynamicLogicVisible": {
            "conditionGroup": [
                {
                    "type": "isNotEmpty",
                    "attribute": "errorMessage"
                }
            ]
        },
        "rows": [
            [
                {
                    "name": "errorMessage",
                    "fullWidth": true
                }
            ]
        ]
    },
