<div class="stream-head-container">
    <div class="pull-left">{{{avatar}}}</div>
    <div class="stream-head-text-container">
        <span class="{{iconClass}} text-muted" aria-hidden="true"></span>
        <a href="{{eventUrl}}" target="_blank" rel="noopener noreferrer">{{label}}</a>
    </div>
</div>
<div class="stream-date-container">
    <a class="text-muted small" href="#Note/view/{{model.id}}">{{{createdAt}}}</a>
</div>
